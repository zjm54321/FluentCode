<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{2BAEB01B-1542-4339-B046-32B7570DFA6A}</ProjectGuid>
    <ProjectName>FluentCode.Package</ProjectName>
    <TargetPlatformIdentifier>UAP</TargetPlatformIdentifier>
    <TargetPlatformVersion>10.0.26100.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.19044.0</TargetPlatformMinVersion>
    <DefaultLanguage>en-US</DefaultLanguage>
    <EntryPointExe>FluentCode.exe</EntryPointExe>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <AppxPackageFileName>FluentCode_1.2611.8.0_x64.msix</AppxPackageFileName>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <UapAppxPackageBuildMode>SideloadOnly</UapAppxPackageBuildMode>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
    <AppxGenerateTestArtifacts>false</AppxGenerateTestArtifacts>
    <DesktopBridgePropsPath>$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\Microsoft.DesktopBridge.props</DesktopBridgePropsPath>
    <DesktopBridgeTargetsPath>$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\Microsoft.DesktopBridge.targets</DesktopBridgeTargetsPath>
  </PropertyGroup>
  <Import Project="$(DesktopBridgePropsPath)" />
  <ItemGroup>
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <AppxManifest Include="Package.appxmanifest" />
    <Content Include="Assets\*.png" />
    <!-- Packaged XAML resolves through the package's primary resources.pri, not loose sidecar PRIs.
         FluentCode.pri already merges the app, WinUI and control resources: index it exactly once. -->
    <Content Include="$(FluentCodePayloadDirectory)\FluentCode.pri">
      <Link>FluentCode.pri</Link>
    </Content>
    <!-- A full publish is supplied explicitly, including the separately copied npm tree and node.exe.
         No project reference: publishing is done once with the packaged, self-contained properties. -->
    <!-- Other SDK PRIs and loose XBFs stay opaque: merging them again would duplicate resources
         already in FluentCode.pri. npm filenames must not be interpreted as resource qualifiers. -->
    <AppxPackagePayload Include="$(FluentCodePayloadDirectory)\**\*" Exclude="$(FluentCodePayloadDirectory)\**\*.pdb;$(FluentCodePayloadDirectory)\FluentCode.pri">
      <TargetPath>%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      <ProjectName>$(ProjectName)</ProjectName>
    </AppxPackagePayload>
  </ItemGroup>
  <Target Name="ValidateFluentCodePayload" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(FluentCodePayloadDirectory)' == '' Or !Exists('$(FluentCodePayloadDirectory)\FluentCode.exe')"
           Text="Use scripts/package-msix.ps1 to prepare a complete self-contained payload before packaging." />
    <Error Condition="'$(Platform)' != 'x64'" Text="FluentCode MSIX supports x64 only." />
  </Target>
  <Import Project="$(DesktopBridgeTargetsPath)" />
</Project>
