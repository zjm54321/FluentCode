<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Configurations>Debug;Release</Configurations>
    <Platforms>x64;arm64</Platforms>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>


    <IsPackable>true</IsPackable>
    <PackageId>WindowsTerminalControl.Core</PackageId>
    <Description>Transport abstractions and a local ConPTY session for Windows Terminal controls.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

  </PropertyGroup>

  <ItemGroup>
    <!-- Remote-only integration: keep the original source for provenance, not a local backend. -->
    <Compile Remove="ConPtySession.cs" />
  </ItemGroup>

</Project>
