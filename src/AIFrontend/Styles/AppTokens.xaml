<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        OpenCode 页布局常量（重设计 v3 §1、§2）。只放尺寸与字体族；颜色一律直接使用 WinUI 内置主题资源
        （TextFillColor* / SystemFillColor* / CardBackgroundFillColor* 等），这里不定义任何颜色、不覆盖强调色。
        圆角使用内置 ControlCornerRadius（4）与 OverlayCornerRadius（8），不在此重复定义。
        需要 BasedOn 内置文字样式的派生样式放在 App.xaml 主字典（与 XamlControlsResources 同一作用域）。
    -->

    <!-- 时间线 / 输入区居中最大宽度 -->
    <x:Double x:Key="OpenCodeTimelineMaxWidth">820</x:Double>
    <!-- 空白新标签页（L2）内容最大宽度 -->
    <x:Double x:Key="OpenCodeNewSessionMaxWidth">760</x:Double>
    <!-- 左侧会话面板 / 右侧概况面板展开宽度 -->
    <x:Double x:Key="OpenCodeSessionPaneLength">320</x:Double>
    <x:Double x:Key="OpenCodeInsightsPaneLength">360</x:Double>
    <!-- 标签标题最大宽度（单行省略） -->
    <x:Double x:Key="OpenCodeSessionTabTitleMaxWidth">200</x:Double>

    <!--
        应用字体（F11，设置 → 外观 → 字体）。这里是启动前的默认值；Services/Appearance/AppFonts 在主窗口创建前
        与每次用户修改后，把同名键写入 Application.Resources 顶层（覆盖本字典）。界面一律用 {ThemeResource 键} 引用，
        运行期修改由 AppFonts 延迟刷新已登记根 / 缓存页面 / 弹出层；不翻转 RequestedTheme。
        ContentControlThemeFontFamily 覆盖 WinUI 内置同名键：内置控件模板与 App.xaml 中重定义的内置文字样式都引用它。
    -->
    <FontFamily x:Key="ContentControlThemeFontFamily">XamlAutoFontFamily</FontFamily>
    <!-- 正文基准字号；字号刷新保留每个文字消费者原有比例，不覆盖框架字号 / 图标资源。 -->
    <x:Double x:Key="AppTextSize">14</x:Double>
    <FontFamily x:Key="AppBodyFontFamily">XamlAutoFontFamily</FontFamily>
    <FontFamily x:Key="AppSerifFontFamily">Cambria, Noto Serif SC, Source Han Serif SC, SimSun</FontFamily>
    <FontFamily x:Key="AppMonospaceFontFamily">Cascadia Mono, Consolas</FontFamily>
    <!-- 代码 / 路径 / 命令：旧键，与 AppMonospaceFontFamily 同步（新代码请用 AppMonospaceFontFamily）。 -->
    <FontFamily x:Key="OpenCodeMonospaceFontFamily">Cascadia Mono, Consolas</FontFamily>

    <!-- 状态圆点：填充色经 ThemeResource 设置，主题切换（浅色/深色/高对比度）时由框架自动重取。 -->
    <Style x:Key="OpenCodeAttentionDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{ThemeResource SystemFillColorAttentionBrush}" />
    </Style>
    <Style x:Key="OpenCodeCautionDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{ThemeResource SystemFillColorCautionBrush}" />
    </Style>
</ResourceDictionary>
