<Page
    x:Class="AIFrontend.Pages.OpenCodePage"
    Background="Transparent"
    AutomationProperties.AutomationId="OpenCodePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:openCode="using:AIFrontend.Pages.OpenCode"
    mc:Ignorable="d">

    <!--
        重设计 v3 §2 页面骨架（L1）：
          Row 0  TabView（会话切换器；标签无内容，只有一套时间线/输入区，见 OpenCodePage.Tabs.cs）
          Row 1  双侧 SplitView：页面宽度与滞回由 OpenCodePage.Sidebars.cs 管理；宽屏 Inline 常驻，窄屏 Overlay 抽屉。
                 工作区 = 右侧概况面板 → 状态行 / 进度 / InfoBar / 时间线 / 交互区 / 排队条 / 输入区
        全部为 WinUI 原生控件与内置样式、主题资源；不设置 RequestedTheme（跟随系统）。
        BG1：MainWindow 提供桌面亚克力，NavigationView 内容层与页面根透明；文字卡片保留标准主题背景。
        SessionPane 不设置 Background（避免叠加或遮挡窗口材质）。
        同时在页面级 Resources.ThemeDictionaries 中将 TabViewItemHeaderBackgroundSelected 映射到
        LayerFillColorDefaultBrush（高对比度为 SystemColorWindowColorBrush），因为元素级 Resources 优先于
        Application.Resources.MergedDictionaries 中的 XamlControlsResources，不会被其默认的
        SolidBackgroundFillColorTertiaryBrush（#FF282828 / #FFF9F9F9）遮蔽。
    -->
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="LayerFillColorDefaultBrush" />
                    <SolidColorBrush x:Key="ShellTerminalBackground" Color="#0C0C0C" />
                    <SolidColorBrush x:Key="ShellTerminalForeground" Color="#CCCCCC" />
                    <SolidColorBrush x:Key="ShellTerminalPrompt" Color="#13A10E" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="LayerFillColorDefaultBrush" />
                    <SolidColorBrush x:Key="ShellTerminalBackground" Color="#0C0C0C" />
                    <SolidColorBrush x:Key="ShellTerminalForeground" Color="#CCCCCC" />
                    <SolidColorBrush x:Key="ShellTerminalPrompt" Color="#13A10E" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="ShellTerminalBackground" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="ShellTerminalForeground" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="ShellTerminalPrompt" ResourceKey="SystemColorWindowTextColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="FullScreenComposerSurfaceStyle" TargetType="Grid">
                <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
            </Style>
            <Style x:Key="ComposerAgentDropdownStyle" TargetType="Button">
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
            </Style>
            <Style x:Key="FullScreenComposerOverlayStyle" TargetType="Grid">
                <Setter Property="Background" Value="{ThemeResource SmokeFillColorDefaultBrush}" />
            </Style>
            <Style x:Key="FullScreenComposerCardStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>
            <!-- BG1: dock columns are base layers, not cards. Keep the entire outer ring transparent;
                 the floating dock cards retain their existing readable surfaces. -->
            <Style x:Key="OpenCodeDockSurfaceStyle" TargetType="Grid">
                <Setter Property="Background" Value="Transparent" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="PageRoot" RowDefinitions="Auto,*" Background="Transparent">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ComposerModeStates">
                <VisualState x:Name="NormalComposerMode" />
                <VisualState x:Name="TerminalComposerMode">
                    <VisualState.Setters>
                        <Setter Target="ComposerCard.Background" Value="{ThemeResource ShellTerminalBackground}" />
                        <Setter Target="ComposerCard.BorderBrush" Value="{ThemeResource ShellTerminalBackground}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <!-- 会话布局 / 空白新标签页布局（§3，L2 经 VisualStateManager.GoToState(this, …) 切换）。
                 输入区 ComposerCell 始终是 SessionLayoutRoot 的同一子元素，只改所在行与可见性，绝不换父元素。 -->
            <VisualStateGroup x:Name="SessionLayoutStates">
                <VisualState x:Name="SessionLayout" />
                <VisualState x:Name="HomeLayout">
                    <VisualState.Setters>
                        <Setter Target="SessionLayoutRoot.Visibility" Value="Collapsed" />
                        <Setter Target="HomePageHost.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NewSessionLayout">
                    <VisualState.Setters>
                        <Setter Target="TimelineGrid.Visibility" Value="Collapsed" />
                        <Setter Target="QueuedPromptsHost.Visibility" Value="Collapsed" />
                        <Setter Target="NewSessionHeader.Visibility" Value="Visible" />
                        <Setter Target="BlankPreferencesHost.Visibility" Value="Visible" />
                        <!-- Do not squeeze a bottom-aligned brand stack into a shrinking star slot.
                             The two empty star rows center the naturally measured brand/editor group. -->
                        <Setter Target="SessionStatusRow.Height" Value="*" />
                        <Setter Target="TimelineRow.Height" Value="Auto" />
                        <Setter Target="NewSessionListRow.Height" Value="Auto" />
                        <Setter Target="NewSessionBottomRow.Height" Value="*" />
                        <Setter Target="ComposerCell.MaxWidth" Value="{StaticResource OpenCodeNewSessionMaxWidth}" />
                        <Setter Target="SessionInsightsButton.IsEnabled" Value="False" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- ============================================================
             Row 0：会话标签（原生 TabView；不并入窗口标题栏）
             ============================================================ -->
        <TabView
            x:Name="SessionTabs"
            Grid.Row="0"
            TabWidthMode="Equal"
            CanReorderTabs="True"
            CanDragTabs="False"
            AllowDropTabs="True"
            SelectedIndex="0"
            IsAddTabButtonVisible="True"
            Loaded="SessionTabs_Loaded"
            AddTabButtonClick="SessionTabs_AddTabButtonClick"
            TabCloseRequested="SessionTabs_TabCloseRequested"
            TabItemsChanged="SessionTabs_TabItemsChanged"
            SelectionChanged="SessionTabs_SelectionChanged"
            AutomationProperties.AutomationId="OpenCodeSessionTabs"
            AutomationProperties.Name="已打开的会话">
            <!-- A real first item exists before the first measure, including disconnected startup.
                 Same native item template as sessions; only its footprint and close policy differ. -->
            <TabView.TabItems>
                <TabViewItem x:Name="HomeTab" IsClosable="False" MinWidth="48" MaxWidth="48"
                             HorizontalContentAlignment="Center" DragStarting="HomeTab_DragStarting"
                             AutomationProperties.AutomationId="OpenCodeHomeTab"
                             AutomationProperties.Name="首页" ToolTipService.ToolTip="首页：项目与会话">
                    <TabViewItem.Header>
                        <FontIcon Glyph="&#xE80F;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </TabViewItem.Header>
                </TabViewItem>
            </TabView.TabItems>

            <TabView.TabStripFooter>
                <StackPanel
                    x:Name="SidebarHeaderActions"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0"
                    Spacing="4">
                    <ToggleButton x:Name="SessionPaneToggleButton" Width="32" Height="32" MinWidth="0" Padding="0"
                                  Click="SessionPaneToggleButton_Click"
                                  AutomationProperties.AutomationId="OpenCodeSessionPaneToggle"
                                  AutomationProperties.Name="会话导航" ToolTipService.ToolTip="会话导航">
                        <FontIcon Glyph="&#xE700;" FontSize="16" />
                    </ToggleButton>
                    <!-- 服务连接状态（只在可确定时显示；可达性来自真实请求结果）。F10b：原生透明按钮，点击打开连接详情 Flyout
                         （服务状态 / MCP / 插件 / LSP）；打开时读取一次服务版本，MCP/插件复用会话概况的显式读取，不轮询。 -->
                    <Button
                        x:Name="ConnectionStatusButton"
                        Style="{StaticResource OpenCodeTransparentToolButtonStyle}"
                        Height="32"
                        Padding="10,0,10,0"
                        Margin="8,0,4,0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="OpenCodeConnectionStatus"
                        AutomationProperties.Name="连接状态">
                        <Button.Flyout>
                            <Flyout
                                x:Name="ConnectionFlyout"
                                Placement="BottomEdgeAlignedRight"
                                Opening="ConnectionFlyout_Opening"
                                Closed="ConnectionFlyout_Closed" />
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse
                                x:Name="ConnectionDot"
                                Width="8"
                                Height="8"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="ConnectionStatusText"
                                Text="尚未连接"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <!-- wave5 G5：上下文参考圆环（OpenCodeContextRing.Root，32×32 原生透明按钮 + 确定进度环 + Flyout），
                         紧挨在“概况”按钮左侧；由页面代码挂入一次。新标签页布局时隐藏。 -->
                    <Border
                        x:Name="ContextRingHost"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="OpenCodeContextRingHost" />
                    <!-- 布局 D 窄模式：“概况”按钮（图标 + 文字）把右侧会话卡片作为浮动面板打开（轻点外部关闭）。宽模式不显示。 -->
                    <Button
                        x:Name="SessionInsightsButton"
                        Height="32"
                        MinWidth="0"
                        Padding="10,0,10,0"
                        VerticalAlignment="Center"
                        Click="SessionInsightsButton_Click"
                        AutomationProperties.AutomationId="OpenCodeSessionInsightsButton"
                        AutomationProperties.Name="概况"
                        ToolTipService.ToolTip="概况">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                                <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE9D2;" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="概况" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </TabView.TabStripFooter>
        </TabView>

        <!-- ============================================================
             Row 1：内容区。不设 Background，直接透出窗口桌面亚克力（BG1）。
             ============================================================ -->
        <!-- Browser pages remain full-sized and mounted even when the overlay is closed. -->
        <Grid x:Name="BrowserHiddenHost" Grid.Row="1" Opacity="0" IsHitTestVisible="False"
              HorizontalAlignment="Left" VerticalAlignment="Top" Loaded="BrowserHiddenHost_Loaded" />
        <SplitView
            x:Name="SessionPane"
            Grid.Row="1"
            DisplayMode="Overlay"
            PanePlacement="Left"
            IsPaneOpen="False"
            OpenPaneLength="{StaticResource OpenCodeSessionPaneLength}"
            PaneBackground="Transparent"
            PaneClosed="SessionPane_PaneClosed"
            AutomationProperties.AutomationId="OpenCodeSessionPane"
            AutomationProperties.Name="会话面板">

            <!-- Layout D left dock: floating 子智能体 card on top, agent/model card aligned with the composer.
                 The cards share solid theme chrome; insets are set by OpenCodePage.Sidebars.cs (UpdateDockInsets). -->
            <SplitView.Pane>
                <Grid x:Name="LeftDock" Style="{StaticResource OpenCodeDockSurfaceStyle}" RowDefinitions="*,Auto" RowSpacing="12" Padding="24,12,8,16">
                    <!-- B4 and B5 own these empty slots; no placeholder data. -->
                    <Grid x:Name="LeftAgentTreeSlot" Grid.Row="0" Visibility="Collapsed" />
                    <Grid x:Name="LeftBottomCardSlot" Grid.Row="1" Visibility="Collapsed" />
                </Grid>
            </SplitView.Pane>

            <Grid>
                <!-- 未配置 / 设置不可用面板：替代工作区显示，不虚构连接状态 -->
                <Border
                    x:Name="NotConfiguredPanel"
                    Visibility="Collapsed"
                    Margin="24,20"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    Padding="24,20"
                    MaxWidth="720"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    AutomationProperties.AutomationId="OpenCodeNotConfiguredPanel">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon
                                Glyph="&#xE7BA;"
                                FontSize="16"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            <TextBlock
                                x:Name="NotConfiguredTitle"
                                Text="OpenCode 后端未配置"
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock
                            x:Name="NotConfiguredDetail"
                            TextWrapping="Wrap"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button
                                x:Name="SettingsRequestButton"
                                Click="SettingsRequestButton_Click"
                                Style="{ThemeResource AccentButtonStyle}"
                                AutomationProperties.AutomationId="OpenCodeSettingsRequestButton"
                                AutomationProperties.Name="打开设置">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE713;" FontSize="12" />
                                    <TextBlock Text="打开设置" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 工作区（未配置时由页面代码整体折叠） -->
                <Grid x:Name="WorkspaceGrid">
                    <!-- Existing real insights stay mounted across resident/drawer mode changes. -->
                    <SplitView
                        x:Name="InsightsPane"
                        DisplayMode="Inline"
                        PanePlacement="Right"
                        IsPaneOpen="False"
                        OpenPaneLength="{StaticResource OpenCodeInsightsPaneLength}"
                        PaneBackground="Transparent"
                        PaneClosed="InsightsPane_PaneClosed"
                        AutomationProperties.AutomationId="OpenCodeSessionInsightsPane"
                        AutomationProperties.Name="会话概况面板">
                        <SplitView.Pane>
                            <!-- Layout D right dock: session card (title → id → 上下文 → usage → 汇总/花费 → to do) on top,
                                 directory + OpenCode version card aligned with the composer. Insets: UpdateDockInsets. -->
                            <Grid x:Name="RightDock" Style="{StaticResource OpenCodeDockSurfaceStyle}" RowDefinitions="*,Auto" RowSpacing="12" Padding="8,12,24,16">
                                <Border x:Name="RightSessionCard" VerticalAlignment="Top" Style="{StaticResource DockCard}"
                                        Translation="0,0,16"
                                        AutomationProperties.AutomationId="OpenCodeRightSessionCard">
                                    <Border.Shadow>
                                        <ThemeShadow />
                                    </Border.Shadow>
                                    <!-- Only To Do owns a vertical ScrollViewer. Star rows carry the dock's finite height to it. -->
                                    <Grid x:Name="RightSessionContent" Padding="16" RowSpacing="16" RowDefinitions="Auto,*">
                                        <StackPanel Spacing="16">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                                <StackPanel x:Name="RightPanelHeaderSlot" Spacing="12" Visibility="Collapsed" />
                                                <!-- Compatibility hosts; the ring is shown only in the narrow header. -->
                                                <StackPanel x:Name="RightPanelExistingActions" Grid.Column="1" Orientation="Horizontal"
                                                            Spacing="4" VerticalAlignment="Top" Margin="0,-4,-8,0">
                                                    <Border x:Name="RightContextRingHost" VerticalAlignment="Center" />
                                                    <Border x:Name="RightConnectionStatusHost" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel x:Name="WslQuickAccessSection" Visibility="Collapsed" Spacing="0">
                                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                                <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="4" Margin="0,12,0,0">
                                                    <Grid x:Name="WslQuickAccessSlot" Visibility="Collapsed" HorizontalAlignment="Left" />
                                                    <Grid x:Name="BrowserButtonSlot" Grid.Column="1" Visibility="Collapsed" />
                                                    <Grid x:Name="PersistentPtyButtonSlot" Grid.Column="2" />
                                                    <Grid x:Name="BrowserCommandsSlot" Grid.Column="3" HorizontalAlignment="Right" Visibility="Collapsed" />
                                                </Grid>
                                                <Grid x:Name="BrowserStripSlot" />
                                                <Grid x:Name="PersistentPtyStripSlot" />
                                                <Grid x:Name="WslQuickAccessNoteSlot" Visibility="Collapsed" Margin="0,12,0,0" />
                                            </StackPanel>
                                            <Border x:Name="RightContextDivider" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                            <StackPanel x:Name="RightSessionDiagnostics" Spacing="8">
                                                <!-- Preserve switch diagnostics and explicit unknown-outcome recovery, not the retired identity row. -->
                                                <StackPanel x:Name="AgentSelectorHost" AutomationProperties.AutomationId="OpenCodeAgentSelectorHost" />
                                                <TextBlock x:Name="WaitingText" Visibility="Collapsed" TextWrapping="Wrap"
                                                           Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           AutomationProperties.AutomationId="OpenCodeWaitingText" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Border x:Name="InsightsPaneHost" Grid.Row="1" />
                                    </Grid>
                                </Border>
                                <Border x:Name="RightFooterCard" Grid.Row="1" Visibility="Collapsed" Style="{StaticResource DockCard}"
                                        Translation="0,0,16" Padding="12,12,12,8"
                                        AutomationProperties.AutomationId="OpenCodeRightFooterCard">
                                    <Border.Shadow>
                                        <ThemeShadow />
                                    </Border.Shadow>
                                    <StackPanel Spacing="6">
                                        <Grid x:Name="RightPanelDirectorySlot" Visibility="Collapsed" />
                                        <Grid x:Name="RightPanelFooterSlot" Visibility="Collapsed" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </SplitView.Pane>

                        <Grid>
                            <!-- 会话布局根：状态行 / 进度 / 提示条 / 时间线 / 交互区 / 排队条 / 输入区（+ 新标签页列表行） -->
                            <!-- S2: replies own their card surfaces; the reading host exposes page acrylic. -->
                            <Grid x:Name="ConversationSurface">
                            <Grid x:Name="SessionLayoutRoot" Padding="16,8,16,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition x:Name="SessionStatusRow" Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition x:Name="TimelineRow" Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                     <RowDefinition x:Name="NewSessionListRow" Height="Auto" />
                                    <RowDefinition x:Name="NewSessionBottomRow" Height="0" />
                                </Grid.RowDefinitions>

                                <!-- Row 1 会话状态说明（F6：横向工作进度线已移除，工作状态由标签栏着色工作环表示） -->
                                <StackPanel x:Name="SessionStatusHints" Grid.Row="1" Spacing="4">
                                    <TextBlock
                                        x:Name="SessionStateHint"
                                        Visibility="Collapsed"
                                        TextWrapping="Wrap"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        AutomationProperties.AutomationId="OpenCodeSessionStateHint" />
                                </StackPanel>

                                <!-- Row 2 提示条（按需） -->
                                <StackPanel Grid.Row="2" Spacing="8" Margin="0,4,0,0">
                                    <InfoBar
                                        x:Name="PermissionBar"
                                        Severity="Warning"
                                        IsOpen="False"
                                        IsClosable="True"
                                        AutomationProperties.AutomationId="OpenCodePermissionBar" />
                                    <InfoBar
                                        x:Name="MessageBar"
                                        Severity="Informational"
                                        IsOpen="False"
                                        IsClosable="True"
                                        AutomationProperties.AutomationId="OpenCodeMessageBar" />
                                </StackPanel>

                                <!-- Row 3 时间线（居中，最大宽度见 OpenCodeTimelineMaxWidth）；新标签页布局时换为标题区 -->
                                <!-- SB1: scrolling covers the whole center area. The ScrollView's native scrollbar is shifted
                                     into the reserved right gutter beside the reading column; the turn navigator
                                     (OpenCodePage.TurnNavigator.cs) sits in the mirrored left gutter. -->
                                <Grid x:Name="TimelineGrid" Grid.Row="3" RowDefinitions="Auto,*"
                                      SizeChanged="TimelineColumn_SizeChanged">
                                    <ScrollView
                                        x:Name="MessageScroll"
                                        VerticalAnchorRatio="NaN"
                                        Grid.Row="1"
                                        HorizontalContentAlignment="Center"
                                        HorizontalScrollMode="Disabled"
                                        HorizontalScrollBarVisibility="Hidden"
                                        VerticalScrollBarVisibility="Auto"
                                        ContentOrientation="Vertical"
                                        Loaded="MessageScroll_Loaded"
                                        ViewChanged="MessageScroll_ViewChanged"
                                        AutomationProperties.AutomationId="OpenCodeMessageScroll">
                                        <Grid
                                            x:Name="MessageHost"
                                             MaxWidth="{StaticResource OpenCodeTimelineMaxWidth}"
                                             HorizontalAlignment="Center"
                                             SizeChanged="TimelineColumn_SizeChanged"
                                             Padding="6,0,6,0" />
                                    </ScrollView>

                                    <!-- F3 消息历史分页：滚动到顶部附近自动加载更早消息（单飞、预插保持阅读位置；
                                         游标语义见 OpenCodePage.MessagePagination.cs）。加载中时在顶部显示小型进度环（叠放，不推动布局）。 -->
                                    <ProgressRing
                                        x:Name="LoadOlderMessagesProgress"
                                        Grid.Row="1"
                                        Width="20"
                                        Height="20"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        IsActive="False"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed"
                                        Loaded="LoadOlderMessagesProgress_Loaded"
                                        AutomationProperties.AutomationId="OpenCodeLoadOlderMessagesProgress"
                                        AutomationProperties.Name="正在加载更早的消息" />

                                    <TextBlock
                                        x:Name="EmptyStateText"
                                        Grid.Row="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        MaxWidth="420"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap"
                                        IsHitTestVisible="False"
                                        Style="{ThemeResource BodyTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                                </Grid>

                                <!-- Row 3（新标签页布局）：标题区，L2 使用；默认折叠 -->
                                <StackPanel
                                    x:Name="NewSessionHeader"
                                    Grid.Row="3"
                                    Visibility="Collapsed"
                                    Spacing="24"
                                    Margin="0,0,0,16"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    AutomationProperties.AutomationId="OpenCodeNewSessionPage"
                                    AutomationProperties.Name="新会话">
                                    <Viewbox MaxWidth="420" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center">
                                        <Image x:Name="NewConversationWordmark" Width="420" Height="75.3846153846" Stretch="Uniform"
                                               AutomationProperties.Name="OpenCode" />
                                    </Viewbox>
                                    <StackPanel x:Name="BlankPreferencesHost" Visibility="Collapsed" Spacing="4" HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                            <TextBlock Text="在" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <DropDownButton x:Name="BlankProjectButton" MinHeight="32" Padding="8,5,8,6"
                                                            Click="BlankProjectButton_Click" AutomationProperties.AutomationId="OpenCodeBlankProject"
                                                            AutomationProperties.Name="工作目录：未选择">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon x:Name="BlankProjectIcon" Glyph="&#xE8B7;" FontSize="16" VerticalAlignment="Center"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock x:Name="BlankProjectName" Text="选择项目目录" MaxWidth="180"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                                    <TextBlock x:Name="BlankProjectPath" Visibility="Collapsed" MaxWidth="240"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               FontFamily="{ThemeResource AppMonospaceFontFamily}"
                                                               Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </DropDownButton>
                                            <TextBlock Text="中开始新会话" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock x:Name="BlankPreferencesHint" Visibility="Collapsed" TextWrapping="Wrap" MaxWidth="600"
                                                   Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Row 4 待处理交互：未锚定提问 / 会话恢复（提交前由页面重新查询 pending 并比对指纹） -->
                                <StackPanel
                                    x:Name="InteractionsSection"
                                    Grid.Row="4"
                                    Spacing="8"
                                    Margin="0,8,0,0"
                                    MaxWidth="{StaticResource OpenCodeTimelineMaxWidth}"
                                    Visibility="Collapsed"
                                    AutomationProperties.AutomationId="OpenCodeInteractionsSection">
                                    <TextBlock
                                        x:Name="InteractionsHeader"
                                        Text="待处理交互"
                                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                                        AutomationProperties.AutomationId="OpenCodeInteractionsHeader" />
                                    <ScrollViewer
                                        x:Name="InteractionsScroll"
                                        MaxHeight="320"
                                        VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Disabled"
                                        AutomationProperties.AutomationId="OpenCodeInteractionsScroll" />
                                </StackPanel>

                                <!-- Row 5 排队条宿主（L6：OpenCodeQueuedPromptsView 放入此处，有未投递条目时才显示） -->
                                <Grid x:Name="ComposerQueueHost" Grid.Row="5">
                                <Grid
                                    x:Name="QueuedPromptsHost"
                                    Margin="0,8,0,0"
                                    MaxWidth="{StaticResource OpenCodeTimelineMaxWidth}"
                                      Visibility="Collapsed" />
                                </Grid>

                                <Button
                                    x:Name="ScrollToBottomButton"
                                    Grid.Row="5"
                                    Grid.RowSpan="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Visibility="Collapsed"
                                    Margin="0,-40,0,0"
                                    Canvas.ZIndex="10"
                                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                    BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    Click="ScrollToBottomButton_Click"
                                    AutomationProperties.AutomationId="OpenCodeScrollToBottomButton"
                                    AutomationProperties.Name="回到底部"
                                    ToolTipService.ToolTip="回到底部">
                                    <FontIcon Glyph="&#xE70D;" FontSize="12" />
                                </Button>

                                <!-- Child-session footer in the composer's place: return bottom-left (when the left drawer
                                     is not resident), stop centred in the remaining width so the two never overlap. Same column as the composer. -->
                                <Grid x:Name="ChildFooter" Grid.Row="6" ColumnSpacing="8"
                                      MaxWidth="{StaticResource OpenCodeTimelineMaxWidth}" ColumnDefinitions="Auto,*,Auto">
                                    <Button x:Name="ChildReturnButton" Height="40" Padding="12,0" Margin="0,12,0,8" Visibility="Collapsed"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Click="ChildReturnButton_Click"
                                            AutomationProperties.AutomationId="OpenCodeChildReturn"
                                            AutomationProperties.Name="返回主智能体" ToolTipService.ToolTip="返回主智能体">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE72B;" FontSize="16" />
                                            <TextBlock Text="返回" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                <Grid x:Name="ChildStopHost" Grid.Column="1" Visibility="Collapsed" Margin="0,12,0,8" HorizontalAlignment="Center">
                                    <Button x:Name="ChildStopButton" Height="40" Padding="20,0"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Click="ChildStopButton_Click"
                                            AutomationProperties.AutomationId="OpenCodeChildStop"
                                            AutomationProperties.Name="停止子智能体">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE71A;" FontSize="16" />
                                            <TextBlock x:Name="ChildStopLabel" Text="停止子智能体" FontSize="16" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                    <Button x:Name="ChildBrowserButton" Grid.Column="2" Height="40" Padding="12,0" Margin="0,12,0,8"
                                            Visibility="Collapsed" Click="ChildBrowserButton_Click"
                                            AutomationProperties.AutomationId="OpenCodeChildBrowser"
                                            AutomationProperties.Name="子智能体浏览器" ToolTipService.ToolTip="子智能体自己的浏览器页面">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE774;" FontSize="16" />
                                            <TextBlock Text="浏览器" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Row 6 输入区单元格：输入卡片 + 权限遮罩宿主（同一单元格，遮罩盖在输入区之上；L5 填充）。
                                     输入框在任何布局/遮罩状态下都留在可视树中、不换父元素。 -->
                                <Grid
                                    x:Name="ComposerCell"
                                    Grid.Row="6"
                                    HorizontalAlignment="Center"
                                    Margin="0,8,0,0"
                                    MaxWidth="{StaticResource OpenCodeTimelineMaxWidth}">
                                    <Border
                                        x:Name="ComposerCard"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{ThemeResource OverlayCornerRadius}"
                                        Padding="12,12,12,10">
                                        <Grid x:Name="ComposerSurfaceRoot">
                                            <!-- Keep the normal surface measured in place; overlay its exact editor bounds. -->
                                            <Grid x:Name="ComposerShellHost" Visibility="Collapsed"
                                                   HorizontalAlignment="Left" VerticalAlignment="Top"
                                                   Width="{Binding ActualWidth, ElementName=Composer}"
                                                   Height="{Binding ActualHeight, ElementName=Composer}">
                                                <TextBox x:Name="ShellComposer"
                                                         FontFamily="{Binding FontFamily, ElementName=Composer}"
                                                         FontSize="{Binding FontSize, ElementName=Composer}"
                                                         FontWeight="{Binding FontWeight, ElementName=Composer}"
                                                         FontStyle="{Binding FontStyle, ElementName=Composer}"
                                                         CharacterSpacing="{Binding CharacterSpacing, ElementName=Composer}"
                                                         IsTextScaleFactorEnabled="{Binding IsTextScaleFactorEnabled, ElementName=Composer}"
                                                         FlowDirection="{Binding FlowDirection, ElementName=Composer}"
                                                         AcceptsReturn="False" TextWrapping="NoWrap"
                                                         Padding="{Binding Padding, ElementName=Composer}"
                                                         BorderThickness="{Binding BorderThickness, ElementName=Composer}"
                                                         CornerRadius="{Binding CornerRadius, ElementName=Composer}"
                                                         UseSystemFocusVisuals="False"
                                                         Background="{ThemeResource ShellTerminalBackground}" BorderBrush="{ThemeResource ShellTerminalBackground}"
                                                         Foreground="{ThemeResource ShellTerminalForeground}"
                                                         AutomationProperties.AutomationId="OpenCodeShellComposer" AutomationProperties.Name="Shell 命令"
                                                         AutomationProperties.HelpText="Enter 执行命令；Esc 或空命令时按退格返回普通输入。">
                                                    <TextBox.Resources>
                                                        <StaticResource x:Key="TextControlBackground" ResourceKey="ShellTerminalBackground" />
                                                        <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="ShellTerminalBackground" />
                                                        <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="ShellTerminalBackground" />
                                                        <StaticResource x:Key="TextControlBackgroundDisabled" ResourceKey="ShellTerminalBackground" />
                                                        <StaticResource x:Key="TextControlBorderBrush" ResourceKey="ShellTerminalBackground" />
                                                        <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="ShellTerminalBackground" />
                                                        <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="ShellTerminalBackground" />
                                                        <StaticResource x:Key="TextControlBorderBrushDisabled" ResourceKey="ShellTerminalBackground" />
                                                        <StaticResource x:Key="TextControlForeground" ResourceKey="ShellTerminalForeground" />
                                                        <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="ShellTerminalForeground" />
                                                        <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="ShellTerminalForeground" />
                                                        <StaticResource x:Key="TextControlForegroundDisabled" ResourceKey="ShellTerminalForeground" />
                                                    </TextBox.Resources>
                                                    <!-- 保留原生 TextBox 编辑/滚动宿主，不生成清空按钮或焦点下划线。 -->
                                                    <TextBox.Template>
                                                        <ControlTemplate TargetType="TextBox">
                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                                                            <ScrollViewer x:Name="ContentElement" Background="{TemplateBinding Background}"
                                                                          Foreground="{TemplateBinding Foreground}" Padding="{TemplateBinding Padding}"
                                                                          HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                                                                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden"
                                                                          IsTabStop="False" ZoomMode="Disabled"
                                                                           AutomationProperties.AccessibilityView="Raw" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </TextBox.Template>
                                                </TextBox>
                                                <TextBlock x:Name="ShellPromptGlyph" Text="$"
                                                           FontFamily="{Binding FontFamily, ElementName=Composer}"
                                                           FontSize="{Binding FontSize, ElementName=Composer}"
                                                           FontWeight="{Binding FontWeight, ElementName=Composer}"
                                                           FontStyle="{Binding FontStyle, ElementName=Composer}"
                                                           CharacterSpacing="{Binding CharacterSpacing, ElementName=Composer}"
                                                           IsTextScaleFactorEnabled="{Binding IsTextScaleFactorEnabled, ElementName=Composer}"
                                                           FlowDirection="{Binding FlowDirection, ElementName=Composer}"
                                                           LineStackingStrategy="BlockLineHeight" TextWrapping="NoWrap" TextAlignment="Right"
                                                           VerticalAlignment="Top" HorizontalAlignment="Left" IsHitTestVisible="False"
                                                           Foreground="{ThemeResource ShellTerminalPrompt}"
                                                           AutomationProperties.AccessibilityView="Raw" />
                                             </Grid>
                                            <ContentControl x:Name="ComposerNormalSurface" HorizontalContentAlignment="Stretch" IsTabStop="False">
                                        <StackPanel>
                                            <!-- 命令 / 附件伴随视图宿主：页面代码挂入 OpenCodeComposerView 后设为可见；未挂入时折叠、不占位。 -->
                                            <Grid
                                                x:Name="ComposerCompanionHost"
                                                Visibility="Collapsed"
                                                AutomationProperties.AutomationId="OpenCodeComposerCompanionHost" />

                                            <!-- Stable parents: wide sessions use one row; narrow and new-session use two. -->
                                            <Grid x:Name="ComposerInputLayout" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" RowSpacing="8" ColumnSpacing="8">
                                                <Grid.Resources>
                                                    <Style TargetType="Button" BasedOn="{StaticResource OpenCodeTransparentToolButtonStyle}">
                                                        <Setter Property="BorderBrush" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
                                                    </Style>
                                                    <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                                                    <StaticResource x:Key="ButtonBorderBrushDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
                                                </Grid.Resources>
                                                <Grid x:Name="ComposerEditorHost" Grid.ColumnSpan="3">
                                                    <!-- 右侧内边距 44 = 全屏按钮 32 + 外边距 4 + 与文字的间隔 8。 -->
                                                    <TextBox
                                                        x:Name="Composer"
                                                        AcceptsReturn="True"
                                                        TextWrapping="Wrap"
                                                        Padding="12,9,44,9"
                                                        MinHeight="40"
                                                        MaxHeight="140"
                                                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                        PlaceholderText="你的下一个好主意是?"
                                                        KeyDown="Composer_KeyDown"
                                                        KeyUp="Composer_KeyUp"
                                                        AutomationProperties.AutomationId="OpenCodeComposer"
                                                        AutomationProperties.Name="消息输入" />
                                                    <!-- Inline "@" mention chips painted over the plain-text editor (OpenCodeComposerMentionChips); never hit-testable. -->
                                                    <Canvas x:Name="ComposerMentionLayer" IsHitTestVisible="False"
                                                            AutomationProperties.AccessibilityView="Raw" />
                                                    <Button x:Name="ComposerExpandButton" Width="32" Height="32" MinWidth="0" Padding="0"
                                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                                                            Visibility="Collapsed" Click="ComposerExpandButton_Click"
                                                            AutomationProperties.AutomationId="OpenCodeComposerExpand"
                                                            AutomationProperties.Name="展开输入框" ToolTipService.ToolTip="展开输入框">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource OpenCodeTransparentToolButtonStyle}">
                                                                <Setter Property="BorderBrush" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
                                                                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </Style>
                                                        </Button.Style>
                                                        <FontIcon Glyph="&#xE740;" FontSize="12" />
                                                    </Button>
                                                </Grid>
                                                        <StackPanel x:Name="ComposerToolbarLeft" Grid.Row="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Bottom">
                                                            <Grid x:Name="ComposerLeadingHost" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                            <Grid x:Name="BlankToolbarChoices" Grid.Row="1" Grid.Column="1"
                                                                  ColumnSpacing="6" VerticalAlignment="Center">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition x:Name="ComposerChoiceSpacer" Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition x:Name="ComposerStatusColumn" Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <openCode:OpenCodeNativeComboBox x:Name="BlankAgentButton"
                                                                         Height="32" MinWidth="96" MaxWidth="220" VerticalAlignment="Center"
                                                                        AutomationProperties.Name="选择智能体" ToolTipService.ToolTip="选择智能体"
                                                                        AutomationProperties.AutomationId="OpenCodeBlankAgent">
                                                                </openCode:OpenCodeNativeComboBox>
                                                                <!-- Same native bordered chrome as the neighbouring agent/effort ComboBoxes, not the toolbar's transparent icon buttons. -->
                                                                <Button x:Name="BlankModelButton" Grid.Column="2" Style="{StaticResource DefaultButtonStyle}"
                                                                         Height="32" MinWidth="96" MaxWidth="260" VerticalAlignment="Center"
                                                                        AutomationProperties.Name="选择模型" ToolTipService.ToolTip="选择模型"
                                                                        AutomationProperties.AutomationId="OpenCodeBlankModel">
                                                                    <!-- Restore the stock per-theme disabled chrome that ComposerInputLayout clears for its icon buttons.
                                                                         ThemeResource colours, not StaticResource brush aliases, so a runtime theme switch repaints them. -->
                                                                    <Button.Resources>
                                                                        <ResourceDictionary>
                                                                            <ResourceDictionary.ThemeDictionaries>
                                                                                <ResourceDictionary x:Key="Default">
                                                                                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{ThemeResource ControlFillColorDisabled}" />
                                                                                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="{ThemeResource ControlStrokeColorDefault}" />
                                                                                </ResourceDictionary>
                                                                                <ResourceDictionary x:Key="Light">
                                                                                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{ThemeResource ControlFillColorDisabled}" />
                                                                                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="{ThemeResource ControlStrokeColorDefault}" />
                                                                                </ResourceDictionary>
                                                                                <ResourceDictionary x:Key="HighContrast">
                                                                                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{ThemeResource SystemColorButtonFaceColor}" />
                                                                                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                                                                                </ResourceDictionary>
                                                                            </ResourceDictionary.ThemeDictionaries>
                                                                        </ResourceDictionary>
                                                                    </Button.Resources>
                                                                </Button>
                                                                <openCode:OpenCodeNativeComboBox x:Name="BlankStrengthButton" Grid.Column="3"
                                                                         Height="32" MinWidth="64" MaxWidth="104" VerticalAlignment="Center"
                                                                        AutomationProperties.Name="选择推理强度" ToolTipService.ToolTip="选择推理强度"
                                                                        AutomationProperties.AutomationId="OpenCodeBlankStrength" />
                                                        <StackPanel x:Name="ComposerToolbarMiddle" Grid.Column="4" Orientation="Horizontal" Spacing="2"
                                                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <Button x:Name="ComposerSubagentsButton" Width="32" Height="32" MinWidth="0" Padding="0"
                                                                    Click="ComposerSubagentsButton_Click" AutomationProperties.Name="后台子智能体"
                                                                    ToolTipService.ToolTip="后台子智能体" AutomationProperties.AutomationId="OpenCodeComposerSubagents">
                                                                <!-- Glyph follows the running background-subagent count (OpenCodePage.ComposerToolbar.cs). -->
                                                                <FontIcon x:Name="ComposerSubagentsGlyph" Glyph="&#xE8F8;" FontSize="16" />
                                                            </Button>
                                                            <Button x:Name="ComposerConnectionButton" Width="20" Height="32" MinWidth="0" Padding="0" Visibility="Collapsed"
                                                                    Click="ComposerConnectionButton_Click" AutomationProperties.Name="OpenCode 连接详情"
                                                                    ToolTipService.ToolTip="OpenCode 连接详情" AutomationProperties.AutomationId="OpenCodeComposerConnection" />
                                                        </StackPanel>
                                                            </Grid>
                                                        <StackPanel
                                                             x:Name="ComposerActions"
                                                             Grid.Row="1"
                                                            Grid.Column="2"
                                                            Orientation="Horizontal"
                                                            Spacing="6"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center">
                                                            <ProgressRing
                                                                x:Name="SendProgress"
                                                                Width="16"
                                                                Height="16"
                                                                IsActive="False"
                                                                Visibility="Collapsed"
                                                                VerticalAlignment="Center"
                                                                AutomationProperties.AutomationId="OpenCodeSendProgress" />
                                                            <Button
                                                                x:Name="ComposerQueueButton"
                                                                Width="32" Height="32" MinWidth="0" Padding="0"
                                                                Visibility="Collapsed" IsEnabled="False"
                                                                Click="ComposerQueueButton_Click"
                                                                AutomationProperties.AutomationId="OpenCodeComposerQueue"
                                                                AutomationProperties.Name="当前回合结束后发送"
                                                                ToolTipService.ToolTip="当前回合结束后发送">
                                                                <FontIcon Glyph="&#xE823;" FontSize="16" />
                                                            </Button>
                                                            <Button
                                                                x:Name="SendStopButton"
                                                                Width="32"
                                                                Height="32"
                                                                MinWidth="0"
                                                                Padding="0"
                                                                IsEnabled="False"
                                                                Style="{ThemeResource AccentButtonStyle}"
                                                                Click="SendStopButton_Click"
                                                                AutomationProperties.AutomationId="OpenCodeSendStopButton"
                                                                AutomationProperties.Name="发送"
                                                                ToolTipService.ToolTip="发送（Enter）">
                                                                <FontIcon
                                                                    x:Name="SendStopIcon"
                                                                    Glyph="&#xE724;"
                                                                    FontSize="14" />
                                                            </Button>
                                                        </StackPanel>
                                             </Grid>
                                         </StackPanel>
                                            </ContentControl>
                                        </Grid>
                                     </Border>

                                    <!-- 权限遮罩宿主（L5：OpenCodePermissionOverlay 放入此处；显示时宽高不小于输入卡片，
                                         输入框保持在可视树中，仅 IsEnabled=False）。默认折叠、无内容。 -->
                                    <Grid
                                        x:Name="PermissionOverlayHost"
                                        Visibility="Collapsed" />
                                    <!-- 提问遮罩宿主（重设计 wave3 F9：OpenCodeQuestionOverlay 放入此处，与权限遮罩同位置盖住输入卡片；
                                         权限优先。默认折叠、无内容。） -->
                                    <Grid
                                        x:Name="QuestionOverlayHost"
                                        Visibility="Collapsed" />
                                </Grid>

                                <!-- Row 7（新标签页布局）：筛选 + 已有会话列表（L2 接线；与会话面板同源数据）。默认折叠。 -->
                                <Grid
                                    x:Name="NewSessionListHost"
                                    Grid.Row="7"
                                    Visibility="Collapsed"
                                    Margin="0,24,0,0"
                                    MaxWidth="{StaticResource OpenCodeNewSessionMaxWidth}"
                                    RowDefinitions="Auto,*"
                                    RowSpacing="8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <TextBlock
                                            Text="或打开已有会话"
                                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                                            VerticalAlignment="Center" />
                                        <AutoSuggestBox
                                            x:Name="NewSessionSearch"
                                            Grid.Column="1"
                                            Width="240"
                                            PlaceholderText="筛选会话"
                                            QueryIcon="Find"
                                            AutomationProperties.AutomationId="OpenCodeNewSessionSearch"
                                            AutomationProperties.Name="筛选会话" />
                                    </Grid>
                                    <ListView
                                        x:Name="NewSessionList"
                                        Grid.Row="1"
                                        SelectionMode="Single"
                                        AutomationProperties.AutomationId="OpenCodeNewSessionList"
                                        AutomationProperties.Name="已有会话" />
                                </Grid>
                            </Grid>

                            <Grid x:Name="HomePageHost" Visibility="Collapsed" />
                            </Grid>
                            <!-- AT6: takes over only the center, preserving both dock regions. -->
                        </Grid>
                    </SplitView>
                </Grid>
            </Grid>
        </SplitView>
        <Grid x:Name="BrowserOverlayHost" Grid.Row="1" HorizontalAlignment="Left" Visibility="Collapsed" />
        <Grid x:Name="PersistentPtyOverlayHost" Grid.Row="1" HorizontalAlignment="Left" Visibility="Collapsed"
              AutomationProperties.AutomationId="OpenCodePersistentPtyOverlayHost" />
    </Grid>
</Page>
