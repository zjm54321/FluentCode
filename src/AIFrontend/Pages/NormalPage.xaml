<Page
    x:Class="AIFrontend.Pages.NormalPage"
    AutomationProperties.AutomationId="NormalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*">
        <!-- 顶部工具栏（Grid Auto/*/Auto，原生 Fluent 结构）：左侧原生 SelectorBar 左对齐；
             中间 * 列自然留白、窄窗时最先收缩为 0，两列元素互不重叠、不互相遮挡；最右原生刷新按钮。
             垂直留白收紧：容器上下内边距由 12/8 收到 4/6；SelectorBar 自身主题内边距
             （SelectorBarPadding = 0,4，generic.xaml）由实例 Padding 归零；
             项内部度量保持 Fluent 默认（不替换控件模板），工具栏整体高度约减少 18 DIP。 -->
        <Grid
            Grid.Row="0"
            Padding="24,4,24,6"
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="12">
            <SelectorBar
                x:Name="ProviderSelector"
                Grid.Column="0"
                AutomationProperties.AutomationId="NormalProviderSelector"
                AutomationProperties.Name="工作区选择"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Padding="0,0"
                SelectionChanged="ProviderSelector_SelectionChanged">
                <!-- 图标占位：以下为系统自带 Segoe 图标字形的通用符号（消息 / 地球 / 机器人 / 代码），
                     非品牌 logo，也不声称代表任何官方品牌标识。官方品牌资源已随仓库落盘于
                     Assets/Brands（ChatGPT 浅/深 SVG、Gemini PNG、Claude SVG；官方出处与商标归属见
                     Assets/Brands/ATTRIBUTION.md，机制说明见 docs/web-ui-contract.md §5.3）；
                     代码侧 Pages/Web/ProviderBrandIcons.cs 在页面 Loaded 及主题变化时按 16 DIP
                     自动替换为 ImageIcon（SVG→SvgImageSource / PNG→BitmapImage），资源缺失或加载
                     失败时保持本通用占位。 -->
                <SelectorBarItem
                    x:Name="ProviderItemChatGpt"
                    AutomationProperties.AutomationId="ProviderItemChatGpt"
                    Text="ChatGPT"
                    Tag="ChatGPT">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE8BD;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem
                    x:Name="ProviderItemGemini"
                    AutomationProperties.AutomationId="ProviderItemGemini"
                    Text="Gemini"
                    Tag="Gemini">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE774;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem
                    x:Name="ProviderItemClaude"
                    AutomationProperties.AutomationId="ProviderItemClaude"
                    Text="Claude"
                    Tag="Claude">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE99A;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem
                    x:Name="ProviderItemLocal"
                    AutomationProperties.AutomationId="ProviderItemLocal"
                    Text="Local"
                    Tag="Local">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE943;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>

            <!-- 刷新按钮：只重载当前选中官网的 WebView2（Reload）；不清 cookie、不重建环境、
                 不触碰其他 profile。Local 标签下由代码整体隐藏（Collapsed，不占位），切回官网恢复；
                 未初始化 / 已关闭时点击为空操作（见 WebViewHost.Refresh）。
                 尺寸加大：MinHeight=40（高于 Fluent 默认 32）、左右内边距 16，图标 16 + 文字“刷新”，
                 可访问名称（AutomationProperties.Name）与 AutomationId 保持不变。 -->
            <Button
                x:Name="RefreshButton"
                Grid.Column="2"
                MinHeight="40"
                Padding="16,0"
                AutomationProperties.AutomationId="NormalRefreshButton"
                AutomationProperties.Name="刷新当前页面"
                ToolTipService.ToolTip="刷新当前页面（仅重新加载，不清除 Cookie）"
                VerticalAlignment="Center"
                Click="RefreshButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                    <TextBlock Text="刷新" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 内容区：三个 WebView2 宿主与 Local 聊天视图（LocalChatView）重叠，仅切换可见性；
             隐藏不销毁，以保留各站点登录态与 Local 当前会话。宿主在代码中挂载。
             页面经 NavigationCacheMode.Required 由 Frame 缓存：主导航离开（Unloaded）仅挂起
             （隐藏）宿主、不关闭 WebView2，返回时同一实例、当前 URL；仅窗口最终关闭路径经
             NormalPage.ShutdownWebViews 做真正释放（见 NormalPage.xaml.cs）。
             三个 Web 宿主各自带圆角容器 + 双层 composition 圆角裁剪（见 WebViewHost.ApplyRoundedClip：
             WebView 元素可视化与宿主自身可视化同时裁剪——Mica 下 Border 圆角对 WebView2 失效，
             且仅裁 WebView visual 会让圆角外遗留宿主层矩形绘制；网页内容随容器真正裁圆）；
             网页配色偏好与控件默认底色随宿主 ActualTheme 同步（WebViewHost.ApplyThemeToWebView，
             切主题不 reload、不清 cookie）；Local 视图不在本轮圆角范围内。 -->
        <Grid
            x:Name="ContentHost"
            Grid.Row="1"
            AutomationProperties.AutomationId="NormalContentHost"
            Margin="24,0,24,20" />
    </Grid>
</Page>
