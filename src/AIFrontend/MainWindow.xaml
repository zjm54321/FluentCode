<Window
    x:Class="AIFrontend.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="AIFrontend"
    mc:Ignorable="d">

    <!-- 根容器：响应动态主题切换 -->
    <Grid x:Name="RootElement">
        <Grid.RowDefinitions>
            <!-- 顶栏（高 48px）：透明背景，直接衬出窗口 Mica -->
            <RowDefinition Height="48" />
            <!-- 主工作区：原生 NavigationView（左栏 + 内容层） -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 临时 WebView2 宿主层（仅用于设置页的 Cookie 清理）：位于 RootElement 第一个子元素，
             绘制在顶栏与 NavigationView 之下，正常时无子元素、不显示、不参与命中测试。
             设置页请求清理某官网环境 cookie 时，主窗口把本层交给 Pages.Web.WebCookieCleaner
             （未挂载态安全清理接口）作为“已加载容器”：由其内部临时加入 1×1 WebViewHost，
             清理后立即关闭并移除；不依赖 NormalPage 是否加载，也不删除用户数据目录。 -->
        <Grid x:Name="TransientCookieHostLayer" Grid.Row="1" IsHitTestVisible="False" />

        <!-- 1. 顶部标题栏：按需返回 + 按需汉堡（仅小窗 Minimal）+ 标题 + 中间搜索框（宽/中）或搜索按钮（小）
             汉堡归属三态互斥：宽/中由左栏顶部内置 PaneToggleButton 承担（此处 HamburgerButton 折叠）；
             小窗内置按钮关闭，汉堡进入本顶栏左组（顺序 返回/汉堡/搜索，见 MainWindow.xaml.cs）。
             可拖动区域由系统标题栏默认区域提供，交互元素经 Passthrough 区域放行（见 MainWindow.xaml.cs）。
             右上窗口按钮由系统 caption 按钮列保留（RightPaddingColumn），交互控件不侵入其区域。 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <!-- 系统 caption 按钮保留区（RTL/左侧按钮场景），宽度按 LeftInset 换算后由代码设置 -->
                <ColumnDefinition x:Name="LeftPaddingColumn" Width="0" />
                <!-- 左组：返回 / 汉堡 / 搜索按钮 / 标题 -->
                <ColumnDefinition Width="Auto" />
                <!-- 中间：原生 AutoSuggestBox 搜索框（仅宽/中显示；小窗折叠，改用左组搜索按钮） -->
                <ColumnDefinition Width="*" />
                <!-- 系统 caption 按钮保留区（LTR 场景），宽度按 RightInset 换算后由代码设置 -->
                <ColumnDefinition x:Name="RightPaddingColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- 左组：顺序为 返回(如可返回) / 汉堡 / 搜索按钮 / 标题 -->
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Center">

                <!-- 经典原生返回按钮：原生 Button + 官方 Fluent 矢量返回箭头。
                     无历史时整体折叠隐藏（不显示也不占位，Auto 列宽归零、后续元素自然左移）；
                     有历史时显示，Auto 列占位使后续元素自然右移让位；可用态由代码按历史驱动 -->
                <Button
                    x:Name="BackButton"
                    AutomationProperties.AutomationId="BackButton"
                    AutomationProperties.Name="返回"
                    ToolTipService.ToolTip="返回"
                    IsEnabled="False"
                    Visibility="Collapsed"
                    Width="36"
                    Height="32"
                    Padding="0"
                    Margin="8,0,0,0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    VerticalAlignment="Center"
                    Click="BackButton_Click">
                    <!-- 返回箭头：官方 Fluent UI System Icons 原生 16 号几何（arrow_left_16_regular，
                         MIT © 2020 Microsoft Corporation；固定 commit、出处与许可证见 docs/back-icon-source.md）。
                         几何逐字取自官方 SVG，16×16 官方画板原样落位：无 Viewbox、无任何缩放，
                         内边距与线宽即官方 16 号绘制稿原值。
                         Fill 用主题画刷（相对官方原始单色为适配改动）：随浅/深主题与高对比自动换色。 -->
                    <Canvas Width="16" Height="16">
                        <!-- 16×16 官方画板：几何按官方原始坐标绘制，未被拉伸、缩放或平移 -->
                        <Path
                            Data="M13.5 8.5C13.7761 8.5 14 8.27614 14 8C14 7.72386 13.7761 7.5 13.5 7.5L3.80298 7.5L7.83448 3.87165C8.03974 3.68692 8.05638 3.37078 7.87165 3.16552C7.68692 2.96027 7.37077 2.94363 7.16552 3.12836L2.16552 7.62835C2.06016 7.72317 2 7.85826 2 8C2 8.14174 2.06016 8.27683 2.16552 8.37165L7.16552 12.8716C7.37077 13.0564 7.68692 13.0397 7.87165 12.8345C8.05638 12.6292 8.03974 12.3131 7.83448 12.1283L3.80298 8.5L13.5 8.5Z"
                            Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                    </Canvas>
                </Button>

                <!-- 汉堡（原生 Button + SymbolThemeFontFamily 的 GlobalNavButton 字形 E700）：
                     仅小窗 Minimal 显示（默认折叠；宽/中的汉堡由左栏顶部内置 PaneToggleButton 承担，
                     见 MainWindow.xaml.cs 的 UpdateResponsiveLayout）。与内置按钮互斥，任一时刻仅一个汉堡可见。
                     点击开合左栏浮出（NavView.IsPaneOpen）。 -->
                <Button
                    x:Name="HamburgerButton"
                    AutomationProperties.AutomationId="HamburgerButton"
                    AutomationProperties.Name="导航"
                    ToolTipService.ToolTip="导航"
                    Visibility="Collapsed"
                    Width="36"
                    Height="32"
                    Padding="0"
                    Margin="4,0,0,0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    VerticalAlignment="Center"
                    Click="HamburgerButton_Click">
                    <FontIcon
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        Glyph="&#xE700;"
                        FontSize="16" />
                </Button>

                <!-- 搜索按钮（仅小窗 Minimal 显示；顶栏左组顺序 返回/汉堡/搜索，位于汉堡右侧）：
                     点击弹出原生 Flyout 承载搜索输入（AutoSuggestBox）。 -->
                <Button
                    x:Name="SearchButton"
                    AutomationProperties.AutomationId="SearchButton"
                    AutomationProperties.Name="搜索"
                    ToolTipService.ToolTip="搜索"
                    Visibility="Collapsed"
                    Width="36"
                    Height="32"
                    Padding="0"
                    Margin="4,0,0,0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    VerticalAlignment="Center">
                    <FontIcon
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        Glyph="&#xE721;"
                        FontSize="16" />
                    <Button.Flyout>
                        <Flyout Placement="Bottom" Opened="SearchFlyout_Opened">
                            <AutoSuggestBox
                                x:Name="SearchBoxFlyout"
                                Width="280"
                                PlaceholderText="搜索导航项"
                                TextChanged="SearchBox_TextChanged"
                                QuerySubmitted="SearchBox_QuerySubmitted"
                                SuggestionChosen="SearchBox_SuggestionChosen">
                                <AutoSuggestBox.QueryIcon>
                                    <SymbolIcon Symbol="Find" />
                                </AutoSuggestBox.QueryIcon>
                            </AutoSuggestBox>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- 标题内容（保留 x:Name 供 Loaded/SizeChanged 时机挂钩） -->
                <StackPanel
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="12,0,16,0"
                    Spacing="10">
                    <FontIcon
                        Glyph="&#xE7F4;"
                        FontSize="14"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock
                        Text="AIFrontend"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>

            <!-- 中间：原生 AutoSuggestBox 搜索框（仅宽/中显示；小窗折叠为左组搜索按钮）。
                 只做既有导航项（普通界面 / OpenCode / 看板）的匹配跳转，不伪造全局内容搜索。 -->
            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Column="2"
                MaxWidth="360"
                Margin="12,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                PlaceholderText="搜索导航项"
                TextChanged="SearchBox_TextChanged"
                QuerySubmitted="SearchBox_QuerySubmitted"
                SuggestionChosen="SearchBox_SuggestionChosen">
                <AutoSuggestBox.QueryIcon>
                    <SymbolIcon Symbol="Find" />
                </AutoSuggestBox.QueryIcon>
            </AutoSuggestBox>
        </Grid>

        <!-- 2. 主工作区：原生 NavigationView，PaneDisplayMode=Auto。
             Auto 三态：宽 → Expanded（Left 展开）、中 → Compact（收窄为图标栏）、
             小 → Minimal（隐藏侧栏，经顶栏汉堡打开）。
             左右栏宽度一律使用 WinUI 原生默认（不覆盖 OpenPaneLength / CompactPaneLength）：
             展开 OpenPaneLength=320、中态 CompactPaneLength=48，均为官方默认值，不做自定义收窄/加宽。
             汉堡归属三态互斥（见 MainWindow.xaml.cs UpdateResponsiveLayout）：
             宽/中 → 内置 PaneToggleButton 显示（模板 PaneToggleButtonGrid 悬浮于左栏顶部，
             落在 PaneContentGrid 的 ToggleButton 行、先于 MenuItems），顶栏 HamburgerButton 折叠；
             小窗 → 内置关闭（含侧栏浮出时），顶栏 HamburgerButton 显示。
             返回保持内置关闭（IsBackButtonVisible=Collapsed），仅顶栏自有 BackButton 承担。
             设置/账户不再使用 PaneFooter 居中小头像：任务状态/账户/设置同为 FooterMenuItems 项
             （SelectsOnInvoked=False，点击不改变页面选中），顺序为 任务状态 → 账户 → 设置最底（贴近窗口底），
             账户紧邻设置上方；进入设置页时由 SyncNavSelectionWithFrame 将 NavSettings 设为选中，返回后回写对应主项。
             设置以应用内页面（Pages.Settings.SettingsPage）经本 Frame 导航承载（双栏：左分类 / 右内容），
             不再用 ContentDialog；离开设置页时若存在未保存输入，由 Frame.Navigating 拦下并做页内三态确认。 -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            FontFamily="{ThemeResource ContentControlThemeFontFamily}"
            PaneDisplayMode="Auto"
            IsPaneToggleButtonVisible="True"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            SelectionChanged="NavView_SelectionChanged"
            ItemInvoked="NavView_ItemInvoked"
            DisplayModeChanged="NavView_DisplayModeChanged"
            PaneOpened="NavView_PaneOpened"
            PaneClosed="NavView_PaneClosed">

            <NavigationView.MenuItems>
                <!-- 导航 1：普通界面（默认选中；首项与顶栏留出呼吸间距） -->
                <NavigationViewItem
                    x:Name="NavNormal"
                    AutomationProperties.AutomationId="NavNormal"
                    AutomationProperties.Name="普通界面"
                    ToolTipService.ToolTip="普通界面"
                    Content="普通界面"
                    Tag="Normal"
                    Margin="0,8,0,0">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            Glyph="&#xE8BD;"
                            FontSize="20" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- 导航 2：OpenCode -->
                <NavigationViewItem
                    x:Name="NavOpenCode"
                    AutomationProperties.AutomationId="NavOpenCode"
                    AutomationProperties.Name="OpenCode"
                    ToolTipService.ToolTip="OpenCode"
                    Content="OpenCode"
                    Tag="OpenCode">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            Glyph="&#xE943;"
                            FontSize="20" />
                    </NavigationViewItem.Icon>
                    <!-- 原生 InfoBadge（默认样式 = 系统 Attention 色）：有会话等待你处理（权限/提问）时显示数量；
                         只有未查看的完成结果时显示圆点；都没有时隐藏。由 MainWindow.OpenCode.cs 按 App 会话状态快照更新。 -->
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge
                            x:Name="NavOpenCodeBadge"
                            Visibility="Collapsed"
                            AutomationProperties.AutomationId="NavOpenCodeAttentionBadge"
                            AutomationProperties.Name="OpenCode 没有需要处理的会话" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>

                <!-- 导航 3：看板 -->
                <NavigationViewItem
                    x:Name="NavBoard"
                    AutomationProperties.AutomationId="NavBoard"
                    AutomationProperties.Name="看板"
                    ToolTipService.ToolTip="看板"
                    Content="看板"
                    Tag="Board">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            Glyph="&#xE8A9;"
                            FontSize="20" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- 左栏底部区（FooterMenuItems：模板行序在 MenuItems 之下、贴近窗口底）：
                 自上而下为 任务状态项 → 账户项 → 设置项（账户紧邻设置上方，设置最底）。
                 账户项 NavAccount（Tag=Account）不再用居中的小头像，改为与设置/导航项一致的
                 整行左对齐项：图标与文字字号同设置（SymbolThemeFontFamily，16 号），
                 未登录时显示“登录”（不假显示已登录）；SelectsOnInvoked=False，点击仅触发
                 ItemInvoked 弹出既有账户菜单（账户状态 + 设置入口），不改变页面选中、不导航。
                 设置项 NavSettings（Tag=Settings）位于左栏最底，SelectsOnInvoked=False；
                 进入设置页时由 SyncNavSelectionWithFrame 把 NavSettings 设为选中（与内容页一致），返回后回写对应主项。 -->
            <NavigationView.FooterMenuItems>
                <!-- 任务状态项：列出本窗口跟踪的执行（Local / OpenCode）与任务栏状态；
                     仅终态（已完成/失败/已取消）可在其中显式确认清除，等待处理/结果未知不可清除。
                     SelectsOnInvoked=False，点击仅弹出 Flyout，不改变页面选中、不导航。 -->
                <NavigationViewItem
                    x:Name="NavTasks"
                    AutomationProperties.AutomationId="TaskStatusButton"
                    AutomationProperties.Name="任务状态"
                    ToolTipService.ToolTip="任务状态"
                    Content="任务状态"
                    Tag="Tasks"
                    SelectsOnInvoked="False">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            Glyph="&#xE7C4;"
                            FontSize="16" />
                    </NavigationViewItem.Icon>
                    <FlyoutBase.AttachedFlyout>
                        <Flyout Placement="Right" Opened="TaskFlyout_Opened">
                            <StackPanel Width="320" Spacing="10">
                                <TextBlock
                                    Text="任务状态"
                                    Style="{ThemeResource BodyTextBlockStyle}"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    x:Name="TaskStatusEmptyHint"
                                    Text="暂无已跟踪的任务。"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel x:Name="TaskStatusList" Spacing="8" />
                                <MenuFlyoutSeparator Margin="-12,0,-12,0" />
                                <Button
                                    x:Name="TaskStatusClearCompleted"
                                    AutomationProperties.AutomationId="TaskStatusClearCompleted"
                                    Content="清除已完成的提醒"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Click="TaskStatusClearCompleted_Click" />
                                <TextBlock
                                    Text="等待处理或结果未知的任务不能被清除，请先在对应页面处理。"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                </NavigationViewItem>

                <!-- 账户项：整行可选、左对齐；图标 E77B（原生符号字形）。点击弹出既有账户菜单。 -->
                <NavigationViewItem
                    x:Name="NavAccount"
                    AutomationProperties.AutomationId="AccountButton"
                    AutomationProperties.Name="账户"
                    ToolTipService.ToolTip="用户 · OpenCode 连接"
                    Content="用户"
                    Tag="Account"
                    SelectsOnInvoked="False">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            Glyph="&#xE77B;"
                            FontSize="16" />
                    </NavigationViewItem.Icon>
                    <!-- 单账号 OpenCode 连接入口；状态只描述保存配置，不假造在线状态。 -->
                    <FlyoutBase.AttachedFlyout>
                        <Flyout Placement="Right">
                            <StackPanel Width="260" Spacing="10">
                                <!-- 账户状态 -->
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE77B;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock
                                        x:Name="AccountConnectionSummary"
                                        Text="未连接 OpenCode"
                                        TextWrapping="Wrap"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        VerticalAlignment="Center" />
                                </StackPanel>

                                <Button Content="连接 OpenCode"
                                        AutomationProperties.AutomationId="AccountConnectOpenCode"
                                        HorizontalAlignment="Stretch"
                                        Click="ConnectOpenCode_Click" />

                                <MenuFlyoutSeparator Margin="-12,0,-12,0" />

                                <!-- 原生设置入口（保留；与左栏底部设置项同源） -->
                                <Button
                                    x:Name="OpenSettings"
                                    AutomationProperties.AutomationId="OpenSettings"
                                    AutomationProperties.Name="设置"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    Click="OpenSettings_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE713;" FontSize="14" />
                                        <TextBlock Text="设置" Style="{ThemeResource BodyTextBlockStyle}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                </NavigationViewItem>

                <!-- 左栏最底：设置项。点击仅触发 ItemInvoked（齿轮旋转 + 进入应用内设置页），不改变页面选中。 -->

                <NavigationViewItem
                    x:Name="NavSettings"
                    AutomationProperties.AutomationId="NavSettings"
                    AutomationProperties.Name="设置"
                    ToolTipService.ToolTip="设置"
                    Content="设置"
                    Tag="Settings"
                    SelectsOnInvoked="False">
                    <NavigationViewItem.Icon>
                        <!-- 齿轮（E713）。点击时旋转一圈；动画由代码在系统允许动画时驱动。 -->
                        <FontIcon
                            x:Name="SettingsGearIcon"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            Glyph="&#xE713;"
                            FontSize="16"
                            RenderTransformOrigin="0.5,0.5" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- 内容层：NavigationView 原生 ContentGrid 自带左上 8px 过渡圆角、
                 右/下贴边铺满、仅上/左 1px 描边与半透明层背景（透出 Mica，不使用实色刷）。
                 Navigated 用于同步返回按钮可用态与主导航选中 -->
            <Frame x:Name="ContentFrame" Navigated="ContentFrame_Navigated" Navigating="ContentFrame_Navigating" />
        </NavigationView>

        <!-- Shell 集成提示条：显示 OpenCode 导航结果与监视诊断的可见提示（主工作区顶部居中、可关闭）。
             正常关闭时不显示、不参与命中测试；文案由 MainWindow 分部在 UI 线程设置，
             不含正文、凭据或内部协议细节。 -->
        <InfoBar
            x:Name="ShellNoticeBar"
            Grid.Row="1"
            AutomationProperties.AutomationId="ShellNoticeBar"
            VerticalAlignment="Top"
            HorizontalAlignment="Center"
            MaxWidth="760"
            Margin="12,8,12,0"
            IsOpen="False"
            IsClosable="True" />
    </Grid>
</Window>
