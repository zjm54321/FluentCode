<Window
    x:Class="FluentCode.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="FluentCode"
    mc:Ignorable="d">

    <!--
        FluentCode 外壳：没有导航栏、没有单独的标题栏行。
        OpenCodePage 铺满整个窗口：它的会话标签行就是窗口标题栏（资源管理器式，见 MainWindow.TitleBar.cs），
        标签行透出窗口 Mica（原外框色），其下内容层为原内容色，贴边、无描边、无外边距。
        尚未添加 OpenCode 时由 WelcomeHost 覆盖整窗（首次运行欢迎页）。
    -->
    <Grid x:Name="RootElement">
        <Frame x:Name="ContentFrame" Navigated="ContentFrame_Navigated" />

        <Grid x:Name="WelcomeHost" Visibility="Collapsed" />

        <!-- Shell 集成提示条：OpenCode 导航结果与监视诊断（标签行下方居中、可关闭）。 -->
        <InfoBar
            x:Name="ShellNoticeBar"
            AutomationProperties.AutomationId="ShellNoticeBar"
            VerticalAlignment="Top"
            HorizontalAlignment="Center"
            MaxWidth="760"
            Margin="12,48,12,0"
            IsOpen="False"
            IsClosable="True" />
    </Grid>
</Window>
