<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19044.0</TargetPlatformMinVersion>
    <RootNamespace>FluentCode</RootNamespace>
    <AssemblyName>FluentCode</AssemblyName>
    <AssemblyTitle>OpenCode 的 Fluent 风格 Windows 客户端</AssemblyTitle>
    <Product>FluentCode</Product>
    <Company>mingz</Company>
    <Publisher>mingz</Publisher>
    <Authors>mingz</Authors>
    <Copyright>Copyright © 2026 mingz. Licensed under GPL-3.0-or-later.</Copyright>
    <Description>OpenCode 的 Fluent 风格 Windows 客户端</Description>
    <Version>1.2611.4</Version>
    <AssemblyVersion>1.2611.4.0</AssemblyVersion>
    <FileVersion>1.2611.4.0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon\app.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType Condition="'$(FluentCodePackaged)' != 'true'">None</WindowsPackageType>
    <WindowsPackageType Condition="'$(FluentCodePackaged)' == 'true'">MSIX</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained Condition="'$(FluentCodePackaged)' != 'true'">false</SelfContained>
    <SelfContained Condition="'$(FluentCodePackaged)' == 'true'">true</SelfContained>
    <DefineConstants Condition="'$(FluentCodePackaged)' == 'true'">$(DefineConstants);FLUENTCODE_PACKAGED</DefineConstants>
    <PublishAot>false</PublishAot>
    <PublishSingleFile>false</PublishSingleFile>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="HtmlSanitizer" Version="9.2.1039" />
    <ProjectReference Include="..\ThirdParty\WindowsTerminalControl\src\WindowsTerminalControl.WinUI\WindowsTerminalControl.WinUI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ApplicationDefinition Include="App.xaml" />
    <Page Include="MainWindow.xaml" />
    <Page Include="Pages\**\*.xaml" />
    <Page Include="Styles\**\*.xaml" />
    <Content Include="Assets\Brands\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\licenses\fluentui-system-icons-LICENSE.txt" Link="licenses\fluentui-system-icons-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="ThirdPartyNotices\OneDarkPro.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\OpenCode\*.svg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\OpenCode\Mermaid\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\ThirdParty\WindowsTerminalControl\LICENSE" Link="ThirdPartyNotices\WindowsTerminalControl-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\ThirdParty\WindowsTerminalControl\NOTICE.md" Link="ThirdPartyNotices\WindowsTerminalControl-NOTICE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\ThirdParty\WindowsTerminalControl\PATCHES.md" Link="ThirdPartyNotices\WindowsTerminalControl-PATCHES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="ThirdPartyNotices\OpenCode.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\AppIcon\app.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\AppIcon\*.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Taskbar\**\*.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="SetFluentCodeInformationalVersion" BeforeTargets="GetAssemblyVersion" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Condition="'$(FluentCodeGitRevision)' == ''" Command="git -C &quot;$(MSBuildProjectDirectory)&quot; rev-parse --short HEAD"
          ConsoleToMSBuild="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="FluentCodeGitRevision" />
    </Exec>
    <Error Condition="'$(FluentCodeGitRevision)' == ''" Text="Git revision is required. Build a Git checkout or supply /p:FluentCodeGitRevision=&lt;short-sha&gt;." />
    <PropertyGroup>
      <InformationalVersion>$(Version)+$(FluentCodeGitRevision)</InformationalVersion>
    </PropertyGroup>
  </Target>
  <Target Name="ValidateOpenCodeBrowserRuntime" BeforeTargets="PrepareForBuild;ComputeFilesToPublish" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_BrowserRuntimeBundleDirectory>$(MSBuildProjectDirectory)\..\..\artifacts\browser-runtime</_BrowserRuntimeBundleDirectory>
    </PropertyGroup>
    <Error Condition="!Exists('$(_BrowserRuntimeBundleDirectory)\node.exe') Or !Exists('$(_BrowserRuntimeBundleDirectory)\runtime-manifest.json') Or !Exists('$(_BrowserRuntimeBundleDirectory)\node_modules\lighthouse\package.json')"
           Text="Browser runtime bundle is missing or incomplete. Run tools/browser-runtime/prepare.ps1 explicitly before building or publishing. Build/publish never downloads or installs the runtime." />
    <Error Condition="!Exists('$(_BrowserRuntimeBundleDirectory)\sidecar.mjs')"
           Text="Browser runtime sidecar entry is missing: artifacts/browser-runtime/sidecar.mjs. Ensure tools/browser-runtime/runtime/sidecar.mjs exists, then run tools/browser-runtime/prepare.ps1 explicitly. Build/publish never generates or installs the sidecar." />
  </Target>
  <!-- The complete npm tree exceeds the .NET Framework Copy task's Windows path limit.
       Keep it out of Content/FileWrites and copy it with the already prepared Node. -->
  <Target Name="CopyOpenCodeBrowserRuntimeToOutput" AfterTargets="Build" DependsOnTargets="ValidateOpenCodeBrowserRuntime" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_BrowserRuntimeOutputDirectory>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(TargetDir)', 'BrowserRuntime'))</_BrowserRuntimeOutputDirectory>
    </PropertyGroup>
    <Exec Command="&quot;$(_BrowserRuntimeBundleDirectory)\node.exe&quot; &quot;$(MSBuildProjectDirectory)\..\..\tools\browser-runtime\copy-runtime.mjs&quot; &quot;$(_BrowserRuntimeBundleDirectory)&quot; &quot;$(_BrowserRuntimeOutputDirectory)&quot;" />
  </Target>
  <Target Name="CopyOpenCodeBrowserRuntimeToPublish" AfterTargets="Publish" DependsOnTargets="ValidateOpenCodeBrowserRuntime" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_BrowserRuntimePublishDirectory>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(PublishDir)', 'BrowserRuntime'))</_BrowserRuntimePublishDirectory>
    </PropertyGroup>
    <Exec Command="&quot;$(_BrowserRuntimeBundleDirectory)\node.exe&quot; &quot;$(MSBuildProjectDirectory)\..\..\tools\browser-runtime\copy-runtime.mjs&quot; &quot;$(_BrowserRuntimeBundleDirectory)&quot; &quot;$(_BrowserRuntimePublishDirectory)&quot;" />
  </Target>
  <!-- Unpackaged publish does not copy the app's merged PRI; without it every XAML LoadComponent fails at launch. -->
  <Target Name="CopyAppPriToPublish" AfterTargets="Publish" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(TargetDir)$(TargetName).pri')" Text="Missing $(TargetName).pri in $(TargetDir); XAML resources would not load." />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pri" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="false" />
  </Target>
  <!-- Debug PRI entries can reference loose XBF files; Release usually embeds them in the PRI. -->
  <Target Name="CopyLooseAppXbfToPublish" AfterTargets="Publish" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_LooseAppXaml Include="@(Page);@(ApplicationDefinition)">
        <OutputXbf>$(TargetDir)%(RelativeDir)%(Filename).xbf</OutputXbf>
        <PublishXbf>$(PublishDir)%(RelativeDir)%(Filename).xbf</PublishXbf>
      </_LooseAppXaml>
      <_LooseAppXaml Remove="@(_LooseAppXaml)" Condition="!Exists('%(_LooseAppXaml.OutputXbf)')" />
    </ItemGroup>
    <Copy SourceFiles="@(_LooseAppXaml->'%(OutputXbf)')" DestinationFiles="@(_LooseAppXaml->'%(PublishXbf)')" SkipUnchangedFiles="false" />
  </Target>
</Project>
