<Application
    x:Class="FluentCode.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- 应用级布局常量（尺寸 / 等宽字体 / 状态圆点样式）；颜色只用内置主题资源。 -->
                <ResourceDictionary Source="ms-appx:///Styles/AppTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                材质分层（H15）：窗口为 Mica Alt（MainWindow.TrySetMicaBackdrop），根 / 顶栏 / 左栏透明，
                NavigationView 内容层（ContentGrid）提供半透明 LayerFillColorDefaultBrush。
                TabView 默认的选中标签背景是不透明的 SolidBackgroundFillColorTertiaryBrush；此处与应用内的 OpenCodePage.Resources
                同步保留轻量样式映射（Default / Light → LayerFillColorDefaultBrush，HighContrast → SystemColorWindowColorBrush）。
                注意 WinUI 3 中 Application.Resources.MergedDictionaries 的 XamlControlsResources 优先于 Application.Resources.ThemeDictionaries，
                因此 OpenCodePage 同时在元素级 Resources.ThemeDictionaries 中声明同一映射，且 SessionPane 不设 Background 以免双重叠加或遮住 Mica。
            -->
            <!-- ShellTerminal*：终端配色（Campbell）。应用级声明供 XamlReader.Load 构造的独立终端视图解析
                 （页面级 ThemeDictionaries 在元素入树前不可见，曾导致点击后台终端闪退）。 -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="LayerFillColorDefaultBrush" />
                    <SolidColorBrush x:Key="ShellTerminalBackground" Color="#0C0C0C" />
                    <SolidColorBrush x:Key="ShellTerminalForeground" Color="#CCCCCC" />
                    <SolidColorBrush x:Key="ShellTerminalPrompt" Color="#13A10E" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="LayerFillColorDefaultBrush" />
                    <SolidColorBrush x:Key="ShellTerminalBackground" Color="#0C0C0C" />
                    <SolidColorBrush x:Key="ShellTerminalForeground" Color="#CCCCCC" />
                    <SolidColorBrush x:Key="ShellTerminalPrompt" Color="#13A10E" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="ShellTerminalBackground" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="ShellTerminalForeground" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="ShellTerminalPrompt" ResourceKey="SystemColorWindowTextColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--
                用户可选正文字体（设置 → 外观 → 字体，F11）。WinUI 内置文字样式把 FontFamily 写死为 XamlAutoFontFamily，
                不跟随 ContentControlThemeFontFamily；这里按框架原值（字号 / 字重 / 裁切 / 行距逐项一致）重定义本应用用到的
                内置文字样式，只把 FontFamily 改为 {ThemeResource ContentControlThemeFontFamily}，使其随 AppFonts 运行期更新。
                默认值仍是 XamlAutoFontFamily（见 Styles/AppTokens.xaml），未自选字体时外观与框架完全一致。
                必须位于下方所有 BasedOn 这些键的派生样式之前（同一字典内 StaticResource 只能向前引用）。
            -->
            <Style x:Key="BaseTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
                <Setter Property="FontSize" Value="{StaticResource BodyTextBlockFontSize}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="LineStackingStrategy" Value="MaxHeight" />
                <Setter Property="TextLineBounds" Value="Full" />
            </Style>
            <Style x:Key="BodyTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                <Setter Property="FontWeight" Value="Normal" />
            </Style>
            <Style x:Key="BodyStrongTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                <Setter Property="FontSize" Value="{StaticResource BodyStrongTextBlockFontSize}" />
            </Style>
            <Style x:Key="BodyLargeTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="FontSize" Value="{StaticResource BodyLargeTextBlockFontSize}" />
                <Setter Property="OpticalMarginAlignment" Value="TrimSideBearings" />
            </Style>
            <Style x:Key="CaptionTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                <Setter Property="FontSize" Value="{StaticResource CaptionTextBlockFontSize}" />
                <Setter Property="FontWeight" Value="Normal" />
            </Style>
            <Style x:Key="SubtitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                <Setter Property="FontSize" Value="{StaticResource SubtitleTextBlockFontSize}" />
                <Setter Property="OpticalMarginAlignment" Value="TrimSideBearings" />
            </Style>
            <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                <Setter Property="FontSize" Value="{StaticResource TitleTextBlockFontSize}" />
                <Setter Property="OpticalMarginAlignment" Value="TrimSideBearings" />
            </Style>
            <Style x:Key="TitleLargeTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                <Setter Property="FontSize" Value="{StaticResource TitleLargeTextBlockFontSize}" />
                <Setter Property="OpticalMarginAlignment" Value="TrimSideBearings" />
            </Style>
            <Style x:Key="DisplayTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                <Setter Property="FontSize" Value="{StaticResource DisplayTextBlockFontSize}" />
                <Setter Property="OpticalMarginAlignment" Value="TrimSideBearings" />
            </Style>

            <!--
                弹出层不在主视觉树内，不继承 NavView 的字体：给原生弹出宿主加隐式样式（BasedOn 框架默认样式，只补 FontFamily），
                其内部无样式 TextBlock / 菜单项随之继承正文字体。显式指定了 FlyoutPresenterStyle 的弹出层不受影响，
                但其中使用上方内置文字样式的文字仍跟随正文字体。
            -->
            <Style TargetType="FlyoutPresenter" BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
                <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
            </Style>
            <Style TargetType="MenuFlyoutPresenter" BasedOn="{StaticResource DefaultMenuFlyoutPresenterStyle}">
                <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
            </Style>
            <Style TargetType="TeachingTip" BasedOn="{StaticResource DefaultTeachingTipStyle}">
                <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
            </Style>

            <!-- RC1: all four dock cards share opaque, theme-aware chrome. Unlike acrylic,
                 this stays gray regardless of backdrop availability or the pane's composition layer. -->
            <Style x:Key="DockCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="DockCardFlyoutPresenterStyle" TargetType="FlyoutPresenter"
                   BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
                <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
                <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <!-- 设置页整块表单的卡片外框（与 CommunityToolkit SettingsCard 同一画刷与圆角；SettingsCards.Panel 使用）。 -->
            <Style x:Key="AppSettingsCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            </Style>

            <!-- WinUI provides the body style and secondary brush separately. -->
            <Style x:Key="BodySubtleTextBlockStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- 次要说明：内置 Caption 字号 + 次要文字色（替代旧的 FontSize=12 + Opacity）。 -->
            <Style x:Key="CaptionSubtleTextBlockStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- 代码 / 路径 / 命令：内置 Caption 字号 + 系统等宽字体（v3 §1 唯一字体例外）。 -->
            <Style x:Key="OpenCodeCodeTextBlockStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="FontFamily" Value="{ThemeResource AppMonospaceFontFamily}" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
            </Style>

            <!-- Same question brushes as before, resolved by the framework on every theme change. -->
            <Style x:Key="OpenCodeQuestionCautionTextStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
            </Style>
            <Style x:Key="OpenCodeQuestionErrorTextStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>
            <Style x:Key="OpenCodeQuestionChromeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            </Style>
            <Style x:Key="OpenCodeQuestionFallbackChromeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>

            <Style x:Key="OpenCodeQuestionStatusTextStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
            <!-- Existing redesign brushes, kept as live ThemeResource references; no geometry/templates. -->
            <Style x:Key="OpenCodeCautionIconStyle" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
            </Style>
            <Style x:Key="OpenCodeSubtleCardChromeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="OpenCodeCardChromeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="OpenCodeDividerBorderStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="OpenCodeDividerSurfaceStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="OpenCodeSubtleSurfaceStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="OpenCodeCardOutlineStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="OpenCodeTransparentToolButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
            </Style>
            <Style x:Key="OpenCodeTransparentSurfaceStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
            </Style>
            <Style x:Key="OpenCodeCautionBadgeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SystemFillColorCautionBackgroundBrush}" />
            </Style>
            <Style x:Key="OpenCodeCriticalBadgeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBackgroundBrush}" />
            </Style>
            <Style x:Key="OpenCodeNeutralBadgeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SystemFillColorNeutralBackgroundBrush}" />
            </Style>

            <!-- 导航轨样式已改为原生 NavigationView/NavigationViewItem，
                 原自绘 ListView 的 StoreRailItemStyle 已移除（见 MainWindow.xaml） -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
