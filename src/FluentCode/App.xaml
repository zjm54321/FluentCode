<Application
    x:Class="FluentCode.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dev="using:DevWinUI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///DevWinUI/Themes/Generic.xaml" />
                <!-- Later merged dictionaries win: retain Toolkit SettingsControls' shared keys and styles. -->
                <ResourceDictionary Source="ms-appx:///CommunityToolkit.WinUI.Controls.SettingsControls/Themes/Generic.xaml" />
                <!-- 应用级布局常量（尺寸 / 等宽字体 / 状态圆点样式）；颜色只用内置主题资源。 -->
                <ResourceDictionary Source="ms-appx:///Styles/AppTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                材质分层（H15）：窗口为 Mica Alt（MainWindow.TrySetMicaBackdrop），根 / 顶栏 / 左栏透明，
                NavigationView 内容层（ContentGrid）提供半透明 LayerFillColorDefaultBrush。
                TabView 默认的选中标签背景是不透明的 SolidBackgroundFillColorTertiaryBrush；此处与应用内的 OpenCodePage.Resources
                同步保留轻量样式映射（Default / Light → LayerFillColorDefaultBrush，HighContrast → SystemColorWindowColorBrush）。
                注意 WinUI 3 中 Application.Resources.MergedDictionaries 的 XamlControlsResources 优先于 Application.Resources.ThemeDictionaries，
                因此 OpenCodePage 同时在元素级 Resources.ThemeDictionaries 中声明同一映射，且 SessionPane 不设 Background 以免双重叠加或遮住 Mica。
            -->
            <!-- ShellTerminal*：终端配色（Campbell）。应用级声明供 XamlReader.Load 构造的独立终端视图解析
                 （页面级 ThemeDictionaries 在元素入树前不可见，曾导致点击后台终端闪退）。 -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="LayerFillColorDefaultBrush" />
                    <SolidColorBrush x:Key="ShellTerminalBackground" Color="#0C0C0C" />
                    <SolidColorBrush x:Key="ShellTerminalForeground" Color="#CCCCCC" />
                    <SolidColorBrush x:Key="ShellTerminalPrompt" Color="#13A10E" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="LayerFillColorDefaultBrush" />
                    <SolidColorBrush x:Key="ShellTerminalBackground" Color="#0C0C0C" />
                    <SolidColorBrush x:Key="ShellTerminalForeground" Color="#CCCCCC" />
                    <SolidColorBrush x:Key="ShellTerminalPrompt" Color="#13A10E" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="ShellTerminalBackground" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="ShellTerminalForeground" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="ShellTerminalPrompt" ResourceKey="SystemColorWindowTextColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--
                用户可选正文字体（设置 → 外观 → 字体，F11）。WinUI 内置文字样式把 FontFamily 写死为 XamlAutoFontFamily，
                不跟随 ContentControlThemeFontFamily；这里按框架原值（字号 / 字重 / 裁切 / 行距逐项一致）重定义本应用用到的
                内置文字样式，只把 FontFamily 改为 {ThemeResource ContentControlThemeFontFamily}，使其随 AppFonts 运行期更新。
                默认值仍是 XamlAutoFontFamily（见 Styles/AppTokens.xaml），未自选字体时外观与框架完全一致。
                必须位于下方所有 BasedOn 这些键的派生样式之前（同一字典内 StaticResource 只能向前引用）。
            -->
            <Style x:Key="BaseTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
                <Setter Property="FontSize" Value="{StaticResource BodyTextBlockFontSize}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="LineStackingStrategy" Value="MaxHeight" />
                <Setter Property="TextLineBounds" Value="Full" />
            </Style>
            <Style x:Key="BodyTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                <Setter Property="FontWeight" Value="Normal" />
            </Style>
            <Style x:Key="BodyStrongTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                <Setter Property="FontSize" Value="{StaticResource BodyStrongTextBlockFontSize}" />
            </Style>
            <Style x:Key="BodyLargeTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="FontSize" Value="{StaticResource BodyLargeTextBlockFontSize}" />
                <Setter Property="OpticalMarginAlignment" Value="TrimSideBearings" />
            </Style>
            <Style x:Key="CaptionTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                <Setter Property="FontSize" Value="{StaticResource CaptionTextBlockFontSize}" />
                <Setter Property="FontWeight" Value="Normal" />
            </Style>
            <Style x:Key="SubtitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                <Setter Property="FontSize" Value="{StaticResource SubtitleTextBlockFontSize}" />
                <Setter Property="OpticalMarginAlignment" Value="TrimSideBearings" />
            </Style>
            <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                <Setter Property="FontSize" Value="{StaticResource TitleTextBlockFontSize}" />
                <Setter Property="OpticalMarginAlignment" Value="TrimSideBearings" />
            </Style>
            <Style x:Key="TitleLargeTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                <Setter Property="FontSize" Value="{StaticResource TitleLargeTextBlockFontSize}" />
                <Setter Property="OpticalMarginAlignment" Value="TrimSideBearings" />
            </Style>
            <Style x:Key="DisplayTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                <Setter Property="FontSize" Value="{StaticResource DisplayTextBlockFontSize}" />
                <Setter Property="OpticalMarginAlignment" Value="TrimSideBearings" />
            </Style>

            <!--
                弹出层不在主视觉树内，不继承 NavView 的字体：给原生弹出宿主加隐式样式（BasedOn 框架默认样式，只补 FontFamily），
                其内部无样式 TextBlock / 菜单项随之继承正文字体。显式指定了 FlyoutPresenterStyle 的弹出层不受影响，
                但其中使用上方内置文字样式的文字仍跟随正文字体。
            -->
            <Style TargetType="FlyoutPresenter" BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
                <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
            </Style>
            <Style TargetType="MenuFlyoutPresenter" BasedOn="{StaticResource DefaultMenuFlyoutPresenterStyle}">
                <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
            </Style>
            <Style TargetType="TeachingTip" BasedOn="{StaticResource DefaultTeachingTipStyle}">
                <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
            </Style>

            <!-- RC1: all four dock cards share opaque, theme-aware chrome. Unlike acrylic,
                 this stays gray regardless of backdrop availability or the pane's composition layer. -->
            <Style x:Key="DockCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
            </Style>
            <!-- 会话页浮动提示的底面：不透明，盖住下面的内容（InfoBar 的信息色底是半透明的）。
                 InfoBar 自己的严重度底色和描边叠在上面，所以这里不再描边。 -->
            <Style x:Key="OpenCodeFloatingNoticeSurfaceStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            </Style>
            <!-- “状态未知”胶囊：同一底面，居中、小号。 -->
            <Style x:Key="OpenCodeFloatingNoticePillStyle" TargetType="Border"
                   BasedOn="{StaticResource OpenCodeFloatingNoticeSurfaceStyle}">
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="12,5,12,6" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
            <Style x:Key="DockCardFlyoutPresenterStyle" TargetType="FlyoutPresenter"
                   BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
                <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
                <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
            </Style>

            <!-- WinUI provides the body style and secondary brush separately. -->
            <Style x:Key="BodySubtleTextBlockStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- 次要说明：内置 Caption 字号 + 次要文字色（替代旧的 FontSize=12 + Opacity）。 -->
            <Style x:Key="CaptionSubtleTextBlockStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- 代码 / 路径 / 命令：内置 Caption 字号 + 系统等宽字体（v3 §1 唯一字体例外）。 -->
            <Style x:Key="OpenCodeCodeTextBlockStyle"
                   TargetType="TextBlock"
                   BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="FontFamily" Value="{ThemeResource AppMonospaceFontFamily}" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
            </Style>

            <!-- Same question brushes as before, resolved by the framework on every theme change. -->
            <Style x:Key="OpenCodeQuestionCautionTextStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
            </Style>
            <Style x:Key="OpenCodeQuestionErrorTextStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>
            <Style x:Key="OpenCodeQuestionChromeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            </Style>
            <Style x:Key="OpenCodeQuestionFallbackChromeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>

            <Style x:Key="OpenCodeQuestionStatusTextStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
            <!-- Existing redesign brushes, kept as live ThemeResource references; no geometry/templates. -->
            <Style x:Key="OpenCodeCautionIconStyle" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
            </Style>
            <Style x:Key="OpenCodeSubtleCardChromeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="OpenCodeCardChromeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="OpenCodeDividerBorderStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="OpenCodeDividerSurfaceStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="OpenCodeSubtleSurfaceStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="OpenCodeCardOutlineStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="OpenCodeTransparentToolButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
            </Style>
            <Style x:Key="OpenCodeTransparentSurfaceStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
            </Style>
            <Style x:Key="OpenCodeCautionBadgeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SystemFillColorCautionBackgroundBrush}" />
            </Style>
            <Style x:Key="OpenCodeCriticalBadgeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBackgroundBrush}" />
            </Style>
            <Style x:Key="OpenCodeNeutralBadgeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SystemFillColorNeutralBackgroundBrush}" />
            </Style>

            <!-- 导航轨样式已改为原生 NavigationView/NavigationViewItem，
                 原自绘 ListView 的 StoreRailItemStyle 已移除（见 MainWindow.xaml） -->

            <!--
                纯文本徽标（A05 / B23 / C06，PLAN-v2 §3）：DevWinUI IssueLabel 承载文本与色调。
                只在这里以键（Key）暴露；除本文件外任何位置都不得出现 DevWinUI 类型 —— 调用方一律经
                Controls/CommunityTextBadge.cs 构造，或按 CONTRACT-F.md 直接引用这里的键。

                几何取舍（见 CONTRACT-F.md「几何」）：
                - 库模板的 SeverityBorder 与 LabelBorder 是同一 Grid 中的同级边框，共用 BorderThickness。
                  设为 0 可同时去掉两者的边框；只去掉严重度描边则要改模板。描边叠在标签边框上，不额外增加高度。
                  两种几何都保留 1 DIP 描边，这是相对旧 Border 徽标（无描边）的有意差异。
                - 中性色调映射到 DevWinUI Gray，深色/浅色底色为不透明的 #212830 / #f6f8fa，不是系统透明填充。
                  高对比度下 Gray、Blue、Purple、Pink 都用 SystemColorWindowColor 填充和
                  SystemColorWindowTextColor 描边/文字；描边保持轮廓对比，四种色调则靠标签文字区分。
                  来源：https://github.com/ghost1372/DevWinUI，提交 6c6c70d55cb7487d3a2aa506d0055ffa0e52ef6e，
                  dev/DevWinUI/Themes/Styles/Controls/IssueLabel.xaml:7-83,182-187（DevWinUI 10.9.1）。
                - 字号/字重/换行/裁切在 AppBadgeTitleTemplate 中统一定义；这里只管盒子。
                - 不设置 Foreground：库模板按「是否本地设置 Foreground」在两个标题呈现器之间二选一，
                  设置它会绕过严重度配色（详见适配器注释）。
            -->
            <DataTemplate x:Key="AppBadgeTitleTemplate">
                <!-- IsTextSelectionEnabled: 迁移前手绘徽章的标签文字是可选中复制的
                     （NativeUiTheme.Text 第 214 行统一置 true），换成库药丸后纯文字徽章会失去该行为。
                     两侧统一为可选中，与迁移前的观感/行为一致。 -->
                <TextBlock Text="{Binding}"
                           FontFamily="{ThemeResource ContentControlThemeFontFamily}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           IsTextSelectionEnabled="True"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" />
            </DataTemplate>
            <!-- 紧凑标签：行内小标签（状态 / 来源 / 推荐）。旧站点为 4 圆角、5~6 横向内边距、11~12px。 -->
            <Style x:Key="AppCompactTextBadgeStyle" TargetType="dev:IssueLabel"
                   BasedOn="{StaticResource DefaultIssueLabelStyle}">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="6,1,6,2" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <!-- 药丸标签：Native UI 的 20 DIP 高、圆角 10 标签（C06）。 -->
            <Style x:Key="AppPillTextBadgeStyle" TargetType="dev:IssueLabel"
                   BasedOn="{StaticResource DefaultIssueLabelStyle}">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="8,2,8,2" />
                <Setter Property="MinHeight" Value="20" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <!--
                流式骨架条（C20）：DevWinUI Shimmer 的盒子与圆角。库的扫光渐变颜色写死在 C#（深色加白 3~6% 透明，
                浅色加黑 2.9~5.4% 透明）；底色是 ShimmerBackground → ControlAltFillColorTertiaryBrush，高对比度下
                映射为 SystemColorWindowColor。模板仍绘制 Border；它是否与宿主融为一色取决于宿主背景。
                调用方在 HighContrast（以及减少动效）时使用静态系统色 Border，而不是仅把 Shimmer 设为不活动。
                IsActive=false 只停止动效；OnApplyTemplate 和 Loaded 仍会尝试初始化合成资源。
                Unloaded 会释放合成资源，重新 Loaded 可重建；库并不要求每次显示都新建控件。
                来源：https://github.com/ghost1372/DevWinUI，提交 6c6c70d55cb7487d3a2aa506d0055ffa0e52ef6e，
                dev/DevWinUI/Controls/Native/Others/Shimmer.cs:58-105 和
                dev/DevWinUI/Themes/Styles/Controls/Shimmer.xaml:8-29（DevWinUI 10.9.1）。
            -->
            <Style x:Key="AppStreamingShimmerStyle" TargetType="dev:Shimmer"
                   BasedOn="{StaticResource DefaultShimmerStyle}">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="12" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="IsHitTestVisible" Value="False" />
            </Style>

            <!-- ============================================================================================
                 P1 共享契约（CONTRACT-F.md）—— 以下键由 F 发布，其它 lane 只消费，不得就地再定义一个同名变体。
                 全部为「同值抽取」：定义与各消费点当前的 XamlReader 字符串逐项一致，不含运行时输入。
                 圆角一律引用内置 OverlayCornerRadius(8)/ControlCornerRadius(4)，不再写死数字。
                 ============================================================================================ -->

            <!-- 右侧快捷入口的 ToggleButton 框（浏览器入口 + 终端入口同值：V 与 B 各自请求了一份相同定义，此处合并为一个键）。
                 恢复态透明、悬停/按下用 subtle 填充；选中态由消费方在各自作用域内用 ThemeResources.Aliases 覆盖，
                 绝不做应用级 ToggleButton 隐式样式。 -->
            <Style x:Key="OpenCodeQuickAccessToggleButtonStyle" TargetType="ToggleButton"
                   BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ButtonBorderBrush}" />
                <Setter Property="BorderThickness" Value="{ThemeResource ButtonBorderThemeThickness}" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            </Style>

            <!-- 浮层 FlyoutPresenter 模板内部 ScrollViewer 的视口对齐（终端浮层与浏览器浮层同值，合并为一个键）。
                 只作为消费方作用域内的隐式 ScrollViewer 样式使用（presenter.Resources），不得并入应用级隐式样式。 -->
            <Style x:Key="OpenCodeOverlayViewportScrollViewerStyle" TargetType="ScrollViewer"
                   BasedOn="{StaticResource DefaultScrollViewerStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>

            <!-- 浮层卡片表面（终端浮层与浏览器浮层同值）：不透明三级背景，避开 DockCard 的 Quarternary。
                 几何（0 内边距、8 圆角、1 DIP 描边、阴影与 Z 位移）留在消费方。 -->
            <Style x:Key="OpenCodeOverlayFlyoutPresenterStyle" TargetType="FlyoutPresenter"
                   BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
                <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" />
            </Style>

            <!-- 模态遮罩（终端浮层、子对话窗、工具详情弹层、页面输入遮罩同值）。 -->
            <Style x:Key="OpenCodeOverlaySmokeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SmokeFillColorDefaultBrush}" />
            </Style>

            <!-- 拾取器弹出层：圆角/字体来自主题，内边距与最小宽度为 0；MaxWidth 依赖锚点宽度，必须由消费方按实例派生。 -->
            <Style x:Key="OpenCodePickerFlyoutPresenterStyle" TargetType="FlyoutPresenter">
                <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
                <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="MinWidth" Value="0" />
            </Style>

            <!-- 自绘上下文菜单表面：与原生 MenuFlyoutPresenter 的配色一致，使菜单看起来就是系统菜单。 -->
            <Style x:Key="OpenCodeContextMenuFlyoutPresenterStyle" TargetType="FlyoutPresenter"
                   BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="MaxWidth" Value="480" />
                <Setter Property="Background" Value="{ThemeResource MenuFlyoutPresenterBackground}" />
                <Setter Property="BorderBrush" Value="{ThemeResource MenuFlyoutPresenterBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
                <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
                <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            </Style>

            <!-- 上下文菜单里自绘按钮的色调（菜单项本身已用 MenuFlyoutItem 的 subtle 填充）。 -->
            <Style x:Key="OpenCodeContextMenuDividerRectangleStyle" TargetType="Rectangle">
                <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="OpenCodeAgentMenuItemStyle" TargetType="MenuFlyoutItem">
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Style>

            <!-- 输入区各色芯片外框：只设背景与描边，内边距/圆角/尺寸留在调用点。 -->
            <Style x:Key="OpenCodeComposerPopupChromeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="OpenCodeComposerCommandChipChromeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SystemFillColorAttentionBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            </Style>
            <Style x:Key="OpenCodeComposerIntentChipChromeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="OpenCodeComposerNativeOriginChromeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AccentFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            </Style>
            <Style x:Key="OpenCodeComposerSecondaryChipChromeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            </Style>

            <!-- 单色前景：只为换色，**不设** BasedOn —— 任何文字样式的字号/换行/字重都会改变现有布局。 -->
            <Style x:Key="OpenCodeAccentTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="OpenCodeSecondaryTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="OpenCodeDisabledTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
            </Style>
            <Style x:Key="OpenCodeTextOnAccentStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="OpenCodeAccentFontIconStyle" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="OpenCodeSecondaryFontIconStyle" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="OpenCodeCriticalFontIconStyle" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>
            <Style x:Key="OpenCodeSuccessFontIconStyle" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
            </Style>

            <!-- 浏览器浮层：悬浮药丸表面（浮层与选区工具栏同值）。药丸的圆角/内边距/阴影/位移留在调用点。 -->
            <Style x:Key="OpenCodeBrowserFloatingPillChromeStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource FlyoutBorderThemeBrush}" />
            </Style>
            <!-- 浏览器浮层工具条 ToggleButton：无边框的 36x32 图标按钮；悬停/按下/禁用别名留在各宿主作用域。 -->
            <Style x:Key="OpenCodeBrowserToolToggleStyle" TargetType="ToggleButton"
                   BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
            </Style>
            <!-- 预览表格列头：可选中复制的正文模板；列头的原生模板与状态保持不变。 -->
            <DataTemplate x:Key="OpenCodeBrowserPreviewTableHeaderTemplate">
                <TextBlock Text="{Binding}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                           FontFamily="{ThemeResource AppBodyFontFamily}" />
            </DataTemplate>

            <!-- 代理树：分组图标与 11px 说明文字（用户自选正文字体经 ContentControlThemeFontFamily 生效）。 -->
            <Style x:Key="OpenCodeAgentTreeAccentIconStyle" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style x:Key="OpenCodeAgentTreeCaptionTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
