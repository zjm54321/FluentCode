<UserControl
    x:Class="FluentCode.Pages.Welcome.WelcomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AutomationId="FluentCodeWelcome"
    AutomationProperties.Name="欢迎使用 FluentCode">

    <!--
        首次运行 / 断开连接后的欢迎页（方案 A）：整窗显示，标题栏只保留可拖动区与系统窗口按钮（无标签）。
        中间：应用图标 · FluentCode · 副标题 · “添加 OpenCode”卡片（原有连接表单，字段与校验不变）。
        背景：直接透出窗口 Mica（外框色），顶部叠一层柔和的强调色光晕。
    -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="Bloom" Grid.RowSpan="2" IsHitTestVisible="False" />

        <!-- 标题栏可拖动区（MainWindow 欢迎态时经 Window.SetTitleBar 登记）。 -->
        <Grid x:Name="DragRegion" Background="Transparent"
              AutomationProperties.AutomationId="FluentCodeWelcomeDragRegion" />

        <!--
            窗口够高时内容在可视区内垂直居中；不够高时从顶部排起、向下滚动，图标和标题始终能看到。
            居中不直接交给 ScrollViewer 的内容：内容比可视区高时，居中的内容上端会跑到可视区之外。
            所以滚动内容是顶对齐的 CenterHost，它的最小高度跟随可视区高度（见 WelcomeView.xaml.cs），居中在它内部完成。
        -->
        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="CenterHost" VerticalAlignment="Top">
            <StackPanel x:Name="Column" MaxWidth="480" Margin="32,0,32,32"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/AppIcon/app-256.png" Width="64" Height="64"
                       HorizontalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock Text="FluentCode" Style="{ThemeResource TitleTextBlockStyle}" HorizontalAlignment="Center"
                           Margin="0,12,0,4" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="连接你的 OpenCode，在 Windows 上继续编码。" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,0,0,20"
                           Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <!-- 卡片：Win11 没有“卡片”控件，这里仍是带主题画刷 / 圆角 / 阴影的普通 Border（阴影是本页特有的抬升，保持局部）。 -->
                <Border Padding="24" CornerRadius="{ThemeResource OverlayCornerRadius}" BorderThickness="1"
                        Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Translation="0,0,24">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <StackPanel Spacing="18">
                        <StackPanel Spacing="4">
                            <TextBlock Text="添加 OpenCode" Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="只保留一个 OpenCode 账号 / 实例；以后可在 设置 › 账号与连接 中切换或断开。"
                                       TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ContentControl x:Name="FormHost" HorizontalContentAlignment="Stretch" IsTabStop="False" />
                    </StackPanel>
                </Border>
            </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
