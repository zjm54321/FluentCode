# IDE state and generated build/validation output.
.vs/
**/bin/
**/obj/
artifacts/
*.user
*.suo
*.log
**/TestResults/

# Local environment values; keep deliberately sanitized examples trackable.
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Runtime user data accidentally copied into the repository root.
# Normal application storage is outside the repository in LocalApplicationData.
/settings.json
/secrets/
/sessions/

# Private certificate bundles, never required as source.
*.pfx
*.p12

# Local orchestration state.
.slim/deepwork/

# BEGIN oh-my-opencode-slim clonedeps
.slim/clonedeps/repos/
# END oh-my-opencode-slim clonedeps

# BEGIN oh-my-opencode-slim worktrees
.slim/worktrees/
.slim/worktrees.json
# END oh-my-opencode-slim worktrees
