<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19044.0</TargetPlatformMinVersion>
    <RootNamespace>RichEditPrototype</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169" />
    <ApplicationDefinition Include="App.xaml" />
    <Compile Include="../../src/FluentCode/Pages/OpenCode/OpenCodeComposerDocument.cs" Link="Production/OpenCodeComposerDocument.cs" />
    <Compile Include="../../src/FluentCode/Pages/OpenCode/OpenCodeComposerEditor.cs" Link="Production/OpenCodeComposerEditor.cs" />
    <Compile Include="../../src/FluentCode/Pages/OpenCode/OpenCodeComposerEditor.Pointer.cs" Link="Production/OpenCodeComposerEditor.Pointer.cs" />
    <Compile Include="../../src/FluentCode/Pages/OpenCode/OpenCodeComposerBitmapCache.cs" Link="Production/OpenCodeComposerBitmapCache.cs" />
    <Compile Include="../../src/FluentCode/Pages/OpenCode/OpenCodeComposerLineMetrics.cs" Link="Production/OpenCodeComposerLineMetrics.cs" />
    <Compile Include="../../src/FluentCode/Pages/OpenCode/OpenCodeComposerActivityPolicy.cs" Link="Production/OpenCodeComposerActivityPolicy.cs" />
    <Compile Include="../../src/FluentCode/Pages/OpenCode/OpenCodeLinkChipView.cs" Link="Production/OpenCodeLinkChipView.cs" />
    <Compile Include="../../src/FluentCode/Pages/OpenCode/OpenCodeLinkChipParser.cs" Link="Production/OpenCodeLinkChipParser.cs" />
    <Compile Include="../../src/FluentCode/Pages/OpenCode/OpenCodeFaviconCache.cs" Link="Production/OpenCodeFaviconCache.cs" />
    <Compile Include="../../src/FluentCode/Pages/OpenCode/OpenCodeAgentIcons.cs" Link="Production/OpenCodeAgentIcons.cs" />
  </ItemGroup>
</Project>
