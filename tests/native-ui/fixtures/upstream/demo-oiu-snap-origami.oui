root = Col([head, viewer, Title("All six steps", "md"), strip, tip])
head = Col([Title("Fold an origami fox", "xl"), Text("A simple fox face from one square of paper: no cutting, about five minutes. Orange on one side and white on the other works best.", "md", "muted"), Row([Badge("Beginner", "success"), Badge("5 minutes", "info"), Badge("One square sheet", "neutral")], 2, null, null, true)], 2)
viewer = Card([Row([Badge("Step 1 of 6", "info"), Spacer(), Caption("16.666666666666664% folded")], 2), Box([Svg([Polygon("100,20 180,100 100,180 20,100", "#FBE6D2", "#B85E1C", 2), Line(20, 100, 180, 100, "#B85E1C", 1.5, 0.5), Line(100, 34, 100, 156, "#B85E1C", 2, 0.8), Polygon("93,150 107,150 100,164", "#B85E1C")], "0 0 200 200")], null, null, 3, "surface", "lg", null, "100%", null, null, "center", "center"), Title("Start with a diamond", "md"), Text("Place the square white side up, with a corner pointing at you.", "sm"), Box([Box([], null, null, null, "chart1", "full", null, "16.666666666666664%", 4)], null, null, null, "border", "full", null, "100%", 4), Row([Button("Back", null, "outline", null, null, "arrow-left", true), Spacer(), Button("Next fold", null, "solid", null, null, "arrow-right")], 2)], null, 4, 3)
strip = Grid([Pressable([Svg([Polygon("100,20 180,100 100,180 20,100", "#FBE6D2", "#B85E1C", 2), Line(20, 100, 180, 100, "#B85E1C", 1.5, 0.5), Line(100, 34, 100, 156, "#B85E1C", 2, 0.8), Polygon("93,150 107,150 100,164", "#B85E1C")], "0 0 200 200"), Caption("1. Start with a diamond")], null, true, 2), Pressable([Svg([Polygon("20,100 180,100 100,180", "#F28C38", "#B85E1C", 2), Line(100, 100, 100, 180, "#B85E1C", 1.5, 0.5)], "0 0 200 200"), Caption("2. Fold it in half")], null, false, 2), Pressable([Svg([Polygon("100,100 60,140 100,180 140,140", "#FBE6D2", "#B85E1C", 2), Line(100, 100, 100, 180, "#B85E1C", 1.5)], "0 0 200 200"), Caption("3. Corners to the point")], null, false, 2), Pressable([Svg([Polygon("60,140 100,100 140,140 100,180", "#F28C38", "#B85E1C", 2), Polygon("62,138 98,124 70,58", "#FBE6D2", "#B85E1C", 2), Polygon("138,138 102,124 130,58", "#FBE6D2", "#B85E1C", 2)], "0 0 200 200"), Caption("4. Make the ears")], null, false, 2), Pressable([Svg([Polygon("60,140 80,118 120,118 140,140 100,180", "#F28C38", "#B85E1C", 2), Polygon("62,138 98,124 70,58", "#FBE6D2", "#B85E1C", 2), Polygon("138,138 102,124 130,58", "#FBE6D2", "#B85E1C", 2), Polygon("80,118 120,118 100,136", "#FBE6D2", "#B85E1C", 1.5)], "0 0 200 200"), Caption("5. Fold the forehead")], null, false, 2), Pressable([Svg([Polygon("60,140 80,118 120,118 140,140 100,180", "#F28C38", "#B85E1C", 2), Polygon("62,138 98,124 70,58", "#F28C38", "#B85E1C", 2), Polygon("138,138 102,124 130,58", "#F28C38", "#B85E1C", 2), Polygon("70,124 88,122 74,82", "#FBE6D2"), Polygon("130,124 112,122 126,82", "#FBE6D2"), Circle(86, 142, 4.5, "#2B2B2B"), Circle(114, 142, 4.5, "#2B2B2B"), Circle(100, 168, 5, "#2B2B2B")], "0 0 200 200"), Caption("6. Turn over and add a face")], null, false, 2)], 6, 96, 2)
