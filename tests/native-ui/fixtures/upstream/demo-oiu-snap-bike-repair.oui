root = Col([head, meta, setup, tools, Title("Assembly, step by step", "md"), progress, checklist, Title("Visual references", "md"), refs, fit, safety])
head = Col([Title("Assemble a youth bike", "xl"), Text("Most youth bikes arrive about 85% built. You fit the handlebars, front wheel, pedals and saddle, then set up the brakes. Tap each step as you finish it.", "md", "muted")], 2)
meta = Row([Badge("45 to 90 minutes", "info"), Badge("Beginner friendly", "success"), Badge("Adult job, kid helper", "purple")], 2, null, null, true)
setup = Row([Label("Brake type"), SegmentedControl($brakes, ["Rim", "Disc", "Coaster"])], 3, null, null, true)
tools = Card([Label("You will need"), List(["4, 5 and 6 mm Allen keys", "15 mm pedal wrench", "Phillips screwdriver", "Pump with a pressure gauge", "Scissors for the zip ties"])], "soft", 3, 2)
progress = Col([Row([Text("0 of 8 steps done", "sm", "muted"), Spacer(), Button("Reset", null, "ghost", null, "sm", "rotate-ccw")], 2), Box([Box([], null, null, null, "chart2", "full", null, "0%", 6)], null, null, null, "border", "full", null, "100%", 6)], 2)
checklist = Col([Pressable([Row([Icon("circle", "md", "faint"), Col([Text("1. Unbox and check", "sm", null, "semibold", false, false), Caption("Cut the zip ties, remove the packaging and lay the parts out: front wheel, pedals marked L and R, saddle and reflectors.")], 1)], 3, "start")], null, false, 3), Pressable([Row([Icon("circle", "md", "faint"), Col([Text("2. Fit the handlebars", "sm", null, "semibold", false, false), Caption("Seat the stem, line the bars up with the front wheel and tighten the bolts evenly, a little at a time.")], 1)], 3, "start")], null, false, 3), Pressable([Row([Icon("circle", "md", "faint"), Col([Text("3. Install the front wheel", "sm", null, "semibold", false, false), Caption("Seat the axle fully in the fork, then close the quick release or tighten both axle nuts. Spin it: it should run straight.")], 1)], 3, "start")], null, false, 3), Pressable([Row([Icon("circle", "md", "faint"), Col([Text("4. Attach the pedals", "sm", null, "semibold", false, false), Caption("The right pedal threads clockwise, the left anticlockwise. Start both by hand, then snug them with the 15 mm wrench.")], 1)], 3, "start")], null, false, 3), Pressable([Row([Icon("circle", "md", "faint"), Col([Text("5. Set the saddle height", "sm", null, "semibold", false, false), Caption("Insert the seat post at least to its minimum insertion mark, set the height below and tighten the clamp.")], 1)], 3, "start")], null, false, 3), Pressable([Row([Icon("circle", "md", "faint"), Col([Text("6. Set up the rim brakes", "sm", null, "semibold", false, false), Caption("Hook the cable noodle into the V-brake arms and center the pads on the rim, not the tire. The wheel should lock before the lever reaches the grip.")], 1)], 3, "start")], null, false, 3), Pressable([Row([Icon("circle", "md", "faint"), Col([Text("7. Inflate the tires", "sm", null, "semibold", false, false), Caption("Pump to the pressure printed on the sidewall and check the bead sits evenly all round.")], 1)], 3, "start")], null, false, 3), Pressable([Row([Icon("circle", "md", "faint"), Col([Text("8. Final safety check", "sm", null, "semibold", false, false), Caption("Check every bolt, fit the reflectors and the bell, and test the brakes at walking pace.")], 1)], 3, "start")], null, false, 3)], 1)
r1 = Col([SearchImage("Bicycle wheel quick release", 1.4, "lg"), Caption("Front wheel seated in the fork")], 1)
r2 = Col([SearchImage("Bicycle pedal", 1.4, "lg"), Caption("Pedals: right clockwise, left anticlockwise")], 1)
r3 = Col([SearchImage("V-brake", 1.4, "lg"), Caption("Brake pads meet the rim squarely")], 1)
r4 = Col([SearchImage("Seatpost", 1.4, "lg"), Caption("Never above the minimum insertion mark")], 1)
refs = Grid([r1, r2, r3, r4], 2, 160, 3)
fit = Card([Title("Saddle height", "sm"), Input($inseam, "Your child's inseam, in cm", "number"), Text("Start with the top of the saddle about **54 cm** from the ground so both feet touch flat. Once your child rides confidently, raise it to about **59 cm**, where only the balls of the feet touch.", "sm")], "soft", 4, 2)
safety = Box([Row([Icon("shield-check", "md", "success"), Text("Before the first ride: the brakes stop the bike, both wheels are tight, the bars do not twist against the front wheel and the helmet fits snugly.", "sm")], 2, "start")], null, null, 3, "success", "lg")
$brakes = "Rim"
$inseam = 56
