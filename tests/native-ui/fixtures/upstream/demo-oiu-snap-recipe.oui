root = Col([head, dishes, planner, Grid([shopping, schedule], 2, 300, 5)], 5)
head = Col([Title("Sunday roast with friends", "xl"), Text("Rosemary and garlic lamb, golden potatoes and all the good things on the side. The shopping list grows with your guest list.", "md", "muted")], 2)
d1 = Col([SearchImage("Lamb roast dinner", 1.4, "lg"), Text("Rosemary & garlic lamb", "sm", null, "semibold"), Caption("The centerpiece, with gravy and mint sauce")], 1)
d2 = Col([SearchImage("Roast potato", 1.4, "lg"), Text("Extra-crispy potatoes", "sm", null, "semibold"), Caption("Fluffy inside, golden edges")], 1)
d3 = Col([SearchImage("Apple crumble", 1.4, "lg"), Text("Bramley apple crumble", "sm", null, "semibold"), Caption("Warm, with custard or cream")], 1)
dishes = Grid([d1, d2, d3], 3, 170, 3)
planner = Card([Row([Col([Text("Guests", "sm", null, "semibold"), Caption("Quantities follow the guest count")], 0), Spacer(), IconButton("minus", null, "Fewer guests"), Title("6", "lg"), IconButton("plus", null, "More guests")], 3)], "soft", 4)
shopping = Card([Row([Title("Shopping list", "md"), Spacer(), Badge("0 of 7 in the basket", "neutral")], 2), Col([Pressable([Row([Icon("circle", "sm", "faint"), Text("Bone-in leg of lamb", "sm", null, null, false, false), Spacer(), Text("2.4 kg", "sm", "muted", "medium", false, false, true)], 2)], null, false, 2), Pressable([Row([Icon("circle", "sm", "faint"), Text("Potatoes", "sm", null, null, false, false), Spacer(), Text("1,800 g", "sm", "muted", "medium", false, false, true)], 2)], null, false, 2), Pressable([Row([Icon("circle", "sm", "faint"), Text("Carrots", "sm", null, null, false, false), Spacer(), Text("9", "sm", "muted", "medium", false, false, true)], 2)], null, false, 2), Pressable([Row([Icon("circle", "sm", "faint"), Text("Parsnips", "sm", null, null, false, false), Spacer(), Text("6", "sm", "muted", "medium", false, false, true)], 2)], null, false, 2), Pressable([Row([Icon("circle", "sm", "faint"), Text("Tenderstem broccoli", "sm", null, null, false, false), Spacer(), Text("750 g", "sm", "muted", "medium", false, false, true)], 2)], null, false, 2), Pressable([Row([Icon("circle", "sm", "faint"), Text("Apples for the crumble", "sm", null, null, false, false), Spacer(), Text("5", "sm", "muted", "medium", false, false, true)], 2)], null, false, 2), Pressable([Row([Icon("circle", "sm", "faint"), Text("Bunches of rosemary", "sm", null, null, false, false), Spacer(), Text("1", "sm", "muted", "medium", false, false, true)], 2)], null, false, 2)], 1), Button("Copy shopping list", null, "outline", null, "sm", "copy")], null, 4, 3)
schedule = Card([Row([Title("Cooking plan", "md"), Spacer(), Text("0 of 5 done", "sm", "muted")], 2), Col([Pressable([Row([Icon("circle", "sm", "faint"), Col([Text("Saturday · Get ahead", "sm", null, "semibold", false, false), Caption("Make the crumble, marinate the lamb and set the table.")], 0)], 3, "start")], null, false, 2), Pressable([Row([Icon("circle", "sm", "faint"), Col([Text("12:30 PM · Lamb in", "sm", null, "semibold", false, false), Caption("200°C for 20 minutes, then 180°C for about 25 minutes per 500 g.")], 0)], 3, "start")], null, false, 2), Pressable([Row([Icon("circle", "sm", "faint"), Col([Text("1:15 PM · Potatoes in", "sm", null, "semibold", false, false), Caption("Parboil, rough up the edges and roast in hot fat.")], 0)], 3, "start")], null, false, 2), Pressable([Row([Icon("circle", "sm", "faint"), Col([Text("2:30 PM · Rest and carve", "sm", null, "semibold", false, false), Caption("Rest the lamb for 20 minutes while the vegetables finish.")], 0)], 3, "start")], null, false, 2), Pressable([Row([Icon("circle", "sm", "faint"), Col([Text("3:00 PM · Serve", "sm", null, "semibold", false, false), Caption("The crumble goes in as you sit down.")], 0)], 3, "start")], null, false, 2)], 1), Button("Start over", null, "ghost", null, "sm", "rotate-ccw")], null, 4, 3)
