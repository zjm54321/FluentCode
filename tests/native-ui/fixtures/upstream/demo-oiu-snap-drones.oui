root = Col([head, Title("How the market is structured", "md"), segments, Title("How big is it?", "md"), sizeCard, Title("Who makes money", "md"), players, Title("Try the economics of a drone photo business", "md"), sim, Title("What is changing", "md"), changes, ask])
head = Col([Title("The drone photography market", "xl"), Text("Aerial photos and video for property, events, inspection and media: a young market where cheap hardware meets licensed, skilled work.", "md", "muted")], 2)
segments = Grid([Card([SearchImage("Suburb aerial view", 1.7, "md"), Text("Real estate and architecture", "sm", null, "semibold"), Caption("Listing photos and video, the steadiest source of work.")], null, 3, 2), Card([SearchImage("Wedding photography", 1.7, "md"), Text("Weddings and events", "sm", null, "semibold"), Caption("Seasonal and priced per event, often sold with a ground crew.")], null, 3, 2), Card([SearchImage("Solar farm aerial", 1.7, "md"), Text("Inspection and surveying", "sm", null, "semibold"), Caption("Roofs, solar farms and building sites; more training, better pay.")], null, 3, 2), Card([SearchImage("Aerial photography coastline", 1.7, "md"), Text("Media and tourism", "sm", null, "semibold"), Caption("Stock footage, tourism boards and film: visible but competitive.")], null, 3, 2)], 2, 220, 3)
sizeCard = Card([Row([Col([Caption("Drone photography services, worldwide, 2026"), Title("$1.1B", "2xl")], 1), Spacer(), Badge("About 19% a year", "success")], 3, null, null, true), Chart("bar", [{year: "2024", size: 860000000}, {year: "2026", size: 1110000000}, {year: "2028", size: 1520000000}, {year: "2030", size: 2260000000}], "year", ["size"], "currency", null, false, 200), Caption("Illustrative figures in the range of public market reports; estimates vary widely with the market definition.")], null, 4, 2)
players = Table(["Who", "How they earn", "Margin"], [["Drone makers", "Hardware, cameras and accessories", Badge("Medium", "warning")], ["Freelance pilots", "Per shoot or per project", Badge("High", "success")], ["Agencies", "Bundles of photo, video and editing", Badge("Medium", "warning")], ["Software platforms", "Mapping and processing subscriptions", Badge("High", "success")]])
k1 = Card([Caption("Revenue a month"), Title("$5,400", "lg")], "soft", 3, 1)
k2 = Card([Caption("Profit a month"), Title("$2,520", "lg", "success")], "soft", 3, 1)
k3 = Card([Caption("Margin"), Title("46.7%", "lg")], "soft", 3, 1)
k4 = Card([Caption("Break-even"), Title("5 projects", "lg")], "soft", 3, 1)
sim = Card([Grid([Slider($projects, 0, 40, 1, "Projects per month"), Slider($price, 100, 1500, 25, "Price per project", "$"), Slider($cost, 0, 400, 10, "Cost per project", "$"), Slider($fixed, 0, 6000, 100, "Fixed costs per month", "$")], 2, 240, 5), Grid([k1, k2, k3, k4], 4, 130, 3), Chart("line", [{projects: "0", Revenue: 0, Costs: 1800}, {projects: "5", Revenue: 2250, Costs: 2250}, {projects: "10", Revenue: 4500, Costs: 2700}, {projects: "15", Revenue: 6750, Costs: 3150}, {projects: "20", Revenue: 9000, Costs: 3600}, {projects: "25", Revenue: 11250, Costs: 4050}, {projects: "30", Revenue: 13500, Costs: 4500}, {projects: "35", Revenue: 15750, Costs: 4950}, {projects: "40", Revenue: 18000, Costs: 5400}], "projects", ["Revenue", "Costs"], "currency", null, false, 200), Text("Fixed costs are covered from project 5 each month; every project after that adds $360 of profit.", "sm"), Caption("Illustrative. Fixed costs cover insurance, gear, software and marketing; project costs cover editing and travel.")], null, 4, 4)
changes = List(["Cheaper drones with better cameras push basic photo prices down.", "Licensing, such as FAA Part 107 in the US, keeps casual competition out of paid work.", "Inspection, mapping and thermal imaging grow faster than photography alone.", "Clients increasingly want edited video and 3D models, not just photos."])
ask = Row([Button("Compare with drone inspection services", null, "outline", null, "sm", "arrow-right")])
$cost = 90
