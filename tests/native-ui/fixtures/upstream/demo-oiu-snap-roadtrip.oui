root = Col([head, photos, badges, map, Title("Day by day", "md"), days, budget, before, ask])
head = Col([Title("Ten days in the Pacific Northwest", "xl"), Text("Rain forest, wild beaches, the Columbia River Gorge and a volcano, in one loop from Seattle. Tap a day to find it on the map.", "md", "muted")], 2)
photos = Grid([SearchImage("Mount Rainier Paradise", 1.4, "lg"), SearchImage("Hoh Rain Forest", 1.4, "lg"), SearchImage("Cannon Beach Haystack Rock", 1.4, "lg")], 3, 140, 2)
badges = Row([Badge("Best July to September", "info"), Badge("About 1,150 miles", "neutral"), Badge("9 nights", "purple")], 2, null, null, true)
map = Map([MapMarker("Seattle", 47.6062, -122.3321, "City"), MapMarker("Port Angeles", 48.1181, -123.4307, "Town"), MapMarker("Hoh Rain Forest", 47.8601, -123.9348, "Nature"), MapMarker("Ruby Beach", 47.7107, -124.4152, "Nature"), MapMarker("Astoria", 46.1879, -123.8313, "Town"), MapMarker("Cannon Beach", 45.8918, -123.9615, "Nature"), MapMarker("Portland", 45.5152, -122.6784, "City"), MapMarker("Multnomah Falls", 45.5762, -122.1158, "Nature"), MapMarker("Mount Rainier", 46.786, -121.7353, "Nature")], true, $stop, 360)
days = Col([Pressable([Row([Box([Title("1", "md")], null, null, 2, "info", "md", null, 44, 44, null, "center", "center"), Col([Text("Seattle", "sm", null, "semibold"), Caption("Arrive · overnight in Seattle"), Text("Pike Place Market, the waterfront and the Space Needle at dusk.", "sm", "muted")], 0)], 3, "start")], null, true, 2), Pressable([Row([Box([Title("2", "md")], null, null, 2, "surface", "md", null, 44, 44, null, "center", "center"), Col([Text("Ferry to the Olympic Peninsula", "sm", null, "semibold"), Caption("2.5 h with the ferry · overnight in Port Angeles"), Text("Take the Edmonds ferry, then drive up to Hurricane Ridge for mountain views.", "sm", "muted")], 0)], 3, "start")], null, false, 2), Pressable([Row([Box([Title("3", "md")], null, null, 2, "surface", "md", null, 44, 44, null, "center", "center"), Col([Text("Hoh Rain Forest", "sm", null, "semibold"), Caption("2 h · overnight in Forks"), Text("Walk the Hall of Mosses under moss-draped maples; stop at Lake Crescent on the way.", "sm", "muted")], 0)], 3, "start")], null, false, 2), Pressable([Row([Box([Title("4", "md")], null, null, 2, "surface", "md", null, 44, 44, null, "center", "center"), Col([Text("The wild coast", "sm", null, "semibold"), Caption("1 h · overnight in Kalaloch"), Text("Sea stacks, driftwood and tide pools at Ruby Beach and Rialto Beach.", "sm", "muted")], 0)], 3, "start")], null, false, 2), Pressable([Row([Box([Title("5", "md")], null, null, 2, "surface", "md", null, 44, 44, null, "center", "center"), Col([Text("South to Astoria", "sm", null, "semibold"), Caption("3.5 h · overnight in Astoria"), Text("Cross the Columbia at its mouth and climb the Astoria Column.", "sm", "muted")], 0)], 3, "start")], null, false, 2), Pressable([Row([Box([Title("6", "md")], null, null, 2, "surface", "md", null, 44, 44, null, "center", "center"), Col([Text("Cannon Beach", "sm", null, "semibold"), Caption("40 min · overnight in Cannon Beach"), Text("Haystack Rock at low tide, then the trail at Ecola State Park.", "sm", "muted")], 0)], 3, "start")], null, false, 2), Pressable([Row([Box([Title("7", "md")], null, null, 2, "surface", "md", null, 44, 44, null, "center", "center"), Col([Text("Portland", "sm", null, "semibold"), Caption("1.5 h · overnight in Portland"), Text("Food carts, Powell's Books and the Japanese Garden.", "sm", "muted")], 0)], 3, "start")], null, false, 2), Pressable([Row([Box([Title("8", "md")], null, null, 2, "surface", "md", null, 44, 44, null, "center", "center"), Col([Text("Columbia River Gorge", "sm", null, "semibold"), Caption("1 h each way · overnight in Portland"), Text("Multnomah Falls and the waterfall corridor; check whether a timed permit is needed.", "sm", "muted")], 0)], 3, "start")], null, false, 2), Pressable([Row([Box([Title("9", "md")], null, null, 2, "surface", "md", null, 44, 44, null, "center", "center"), Col([Text("Mount Rainier", "sm", null, "semibold"), Caption("3.5 h · overnight in Ashford"), Text("Wildflower meadows and glacier views on the Skyline Trail at Paradise.", "sm", "muted")], 0)], 3, "start")], null, false, 2), Pressable([Row([Box([Title("10", "md")], null, null, 2, "info", "md", null, 44, 44, null, "center", "center"), Col([Text("Back to Seattle", "sm", null, "semibold"), Caption("2.5 h"), Text("A last morning hike, then return the car in Seattle.", "sm", "muted")], 0)], 3, "start")], null, true, 2)], 1)
k1 = Card([Caption("Trip total"), Title("$4,136", "xl")], "soft", 3, 1)
k2 = Card([Caption("Per person"), Title("$2,068", "xl")], "soft", 3, 1)
budget = Card([Row([Title("Estimated budget", "md"), Spacer(), SegmentedControl($tier, ["Budget", "Mid-range", "Comfort"])], 3, null, null, true), Row([Text("Travelers", "sm"), Spacer(), IconButton("minus", null, "Fewer travelers"), Text("2", "md", null, "semibold", false, false, true), IconButton("plus", null, "More travelers")], 2), Grid([k1, k2], 2, 150, 3), Chart("bar", [{item: "Lodging", amount: 1710}, {item: "Rental car", amount: 600}, {item: "Gas", amount: 196}, {item: "Food", amount: 1300}, {item: "Park pass", amount: 80}, {item: "Ferries and extras", amount: 250}], "item", ["amount"], "currency", null, false, 200), Caption("Summer prices for 9 nights, 1 room, one rental car. Treat it as a starting point.")], null, 4, 3)
before = Card([Title("Before you go", "sm"), List(["Book lodges near Olympic and Rainier months ahead for summer.", "Multnomah Falls may need a timed-use permit in peak season.", "Check wildfire closures and air quality the week you leave.", "An America the Beautiful pass covers both national parks."])], "soft", 4, 2)
ask = Row([Button("Swap a day for the San Juan Islands", null, "outline", null, "sm", "ship")])
$stop = "Seattle"
$tier = "Mid-range"
