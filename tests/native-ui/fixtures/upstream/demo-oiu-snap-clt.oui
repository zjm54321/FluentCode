root = Card([head, SegmentedControl($dist, ["Skewed", "Uniform", "Bimodal"]), Grid([popCard, meanCard], 2, 260, 4), Slider($n, 1, 50, 1, "Values per sample"), buttons, stats, Text("As the sample size grows, the averages of samples pile up in a bell shape around the population mean, even when the population itself is skewed.", "sm", "muted"), quiz], null, 5, 4)
head = Col([Title("The central limit theorem", "lg"), Text("Different populations. The same bell-shaped pattern.", "sm", "muted")], 1)
popCard = Col([Title("Population", "sm"), Caption("The values we draw from"), Chart("bar", [{key: "0", value: 74, start: 0, end: 0.05}, {key: "0.05", value: 19, start: 0.05, end: 0.1}, {key: "0.1", value: 13, start: 0.1, end: 0.15000000000000002}, {key: "0.15", value: 11, start: 0.15000000000000002, end: 0.2}, {key: "0.2", value: 9, start: 0.2, end: 0.25}, {key: "0.25", value: 8, start: 0.25, end: 0.3}, {key: "0.3", value: 7, start: 0.30000000000000004, end: 0.35000000000000003}, {key: "0.35", value: 6, start: 0.35000000000000003, end: 0.4}, {key: "0.4", value: 6, start: 0.4, end: 0.45}, {key: "0.45", value: 6, start: 0.45, end: 0.5}, {key: "0.5", value: 5, start: 0.5, end: 0.55}, {key: "0.55", value: 5, start: 0.55, end: 0.6000000000000001}, {key: "0.6", value: 4, start: 0.6000000000000001, end: 0.6500000000000001}, {key: "0.65", value: 5, start: 0.65, end: 0.7000000000000001}, {key: "0.7", value: 4, start: 0.7000000000000001, end: 0.7500000000000001}, {key: "0.75", value: 4, start: 0.75, end: 0.8}, {key: "0.8", value: 3, start: 0.8, end: 0.8500000000000001}, {key: "0.85", value: 4, start: 0.8500000000000001, end: 0.9000000000000001}, {key: "0.9", value: 4, start: 0.9, end: 0.9500000000000001}, {key: "0.95", value: 3, start: 0.9500000000000001, end: 1}], "key", ["value"], null, null, false, 150)], 1)
meanCard = Col([Title("Sample means", "sm"), Caption("The average of each sample of 5"), Box([Text("Draw samples to see the pattern", "sm", "muted")], null, null, 6, "surface", "lg", true, "100%", 150, null, "center", "center")], 1)
buttons = Row([Button("Draw 100 samples", null, "solid", null, null, "dices"), Button("Draw 500", null, "outline"), Button("Reset", null, "ghost", null, null, "rotate-ccw")], 2, null, null, true)
s1 = Card([Caption("Samples"), Title("0", "xl")], "soft", 3, 1)
s2 = Card([Caption("Mean of the means"), Title("-", "xl"), Caption("Population: 0.25")], "soft", 3, 1)
s3 = Card([Caption("Spread of the means"), Title("-", "xl"), Caption("Theory, σ/√n: 0.127")], "soft", 3, 1)
stats = Grid([s1, s2, s3], 3, 140, 3)
quiz = Card([RadioGroup($answer, [{value: "a", label: "The population becomes normal"}, {value: "b", label: "The sample means form a narrower bell shape"}, {value: "c", label: "Every mean becomes exactly the same"}], "What changes when the sample size grows?"), null], "soft", 4, 2)
$answer = ""
$dist = "Skewed"
$n = 5
