root = Col([head, preview, Title("Tell me about your room", "md"), quiz, Title("Your best matches", "md"), matches, Title("All six colors", "md"), swatches, tip])
head = Col([Title("Find your living room color", "xl"), Text("Answer three questions and the matches update. Tap any color to paint the room.", "md", "muted")], 2)
room = Svg([Rect(0, 0, 320, 132, "#EFE6D3"), Rect(0, 132, 320, 48, "#B08D6A"), Rect(0, 128, 320, 6, "#E9E4DA"), Rect(28, 24, 70, 76, "#DCE9F5", "#FFFFFF", 5), Line(63, 24, 63, 100, "#FFFFFF", 4), Line(28, 62, 98, 62, "#FFFFFF", 4), Rect(196, 30, 70, 44, "#F4F1EA", "#8A7A66", 3), Circle(214, 52, 9, "#C9785A", null, null, 0.7), Circle(238, 48, 12, "#9DB0BF", null, null, 0.7), Rect(150, 98, 150, 40, "#8D9197", null, null, 1, 10), Rect(160, 84, 62, 26, "#8D9197", null, null, 1, 8), Rect(228, 84, 62, 26, "#8D9197", null, null, 1, 8), Rect(144, 104, 16, 34, "#8D9197", null, null, 1, 6), Rect(290, 104, 16, 34, "#8D9197", null, null, 1, 6), Rect(0, 0, 320, 180, "#9EC5FF", null, null, 0.14)], "0 0 320 180")
preview = Card([room, Row([Box([], null, null, null, "#EFE6D3", "full", true, 18, 18), Text("Warm ivory", "sm", null, "semibold"), Spacer(), Caption("North light is cool and flat: warm colors stay warm")], 2, null, null, true)], null, 3, 2)
quiz = Grid([RadioGroup($mood, [{value: "calm", label: "Calm and restful"}, {value: "cozy", label: "Warm and cozy"}, {value: "bright", label: "Light and airy"}, {value: "bold", label: "A bold statement"}], "How should it feel?"), RadioGroup($light, [{value: "north", label: "North facing, cool light"}, {value: "south", label: "South facing, warm sun"}, {value: "east", label: "East or west, changing"}, {value: "low", label: "Little daylight"}], "What light does it get?"), RadioGroup($sofa, [{value: "grey", label: "Grey"}, {value: "blue", label: "Blue"}, {value: "green", label: "Green"}, {value: "brown", label: "Brown leather"}, {value: "white", label: "White or cream"}], "Your sofa")], 3, 200, 4)
matches = Grid([Pressable([Box([], null, null, null, "#EFE6D3", "md", true, "100%", 64), Text("Warm ivory", "sm", null, "semibold"), Caption("Soft and bright, never stark"), Badge("Great match", "success")], null, true, 2), Pressable([Box([], null, null, null, "#CFC5B8", "md", true, "100%", 64), Text("Greige", "sm", null, "semibold"), Caption("A warm neutral that goes with everything"), Badge("Great match", "success")], null, false, 2), Pressable([Box([], null, null, null, "#B5BFA1", "md", true, "100%", 64), Text("Sage green", "sm", null, "semibold"), Caption("Grounded and restful"), Badge("Good match", "info")], null, false, 2)], 3, 150, 3)
swatches = Row([Pressable([Col([Box([], null, null, null, "#EFE6D3", "full", true, 40, 40), Caption("Warm ivory")], 1, "center")], null, true, 2), Pressable([Col([Box([], null, null, null, "#B5BFA1", "full", true, 40, 40), Caption("Sage green")], 1, "center")], null, false, 2), Pressable([Col([Box([], null, null, null, "#CFC5B8", "full", true, 40, 40), Caption("Greige")], 1, "center")], null, false, 2), Pressable([Col([Box([], null, null, null, "#9DB0BF", "full", true, 40, 40), Caption("Dusty blue")], 1, "center")], null, false, 2), Pressable([Col([Box([], null, null, null, "#C9785A", "full", true, 40, 40), Caption("Terracotta")], 1, "center")], null, false, 2), Pressable([Col([Box([], null, null, null, "#2F3E55", "full", true, 40, 40), Caption("Deep navy")], 1, "center")], null, false, 2)], 2, null, null, true)
tip = Text("Paint chips look different on the wall. Try a large sample on two walls and look at it in the morning and the evening before you commit.", "sm", "muted")
$light = "north"
$mood = "calm"
$sofa = "grey"
