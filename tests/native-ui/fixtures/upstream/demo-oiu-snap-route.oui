root = Col([head, photos, badges, map, Card([Row([Icon("map-pin", "md", "info"), Col([Text("Ferry Building", "md", null, "semibold"), Caption("9:00 AM · 45 min · Food")], 0), Spacer(), Button("Directions", null, "outline", null, "sm", "navigation")], 3, null, null, true), Text("Coffee and pastries in the 1898 market hall on the bay.", "sm")], "soft", 3, 2), Row([Title("Stop by stop", "md"), Spacer(), SegmentedControl($pace, ["Relaxed", "Balanced", "Packed"])], 3, null, null, true), itinerary, closing])
head = Col([Title("San Francisco in one day", "xl"), Text("A scenic loop from the waterfront to the Golden Gate, with time to eat, walk and take photos. Tap a pin or a stop for details.", "md", "muted")], 2)
photos = Grid([SearchImage("Golden Gate Bridge", 1.4, "lg"), SearchImage("Painted Ladies Alamo Square", 1.4, "lg"), SearchImage("San Francisco cable car", 1.4, "lg")], 3, 140, 2)
badges = Row([Badge("8 stops", "info"), Badge("About 9.1 hours", "neutral"), Badge("Walk, cable car and bus", "purple")], 2, null, null, true)
map = Map([MapMarker("Ferry Building", 37.7955, -122.3937, "Food"), MapMarker("Coit Tower", 37.8024, -122.4058, "Views"), MapMarker("Lombard Street", 37.8021, -122.4187, "Landmarks"), MapMarker("Fisherman's Wharf", 37.808, -122.4177, "Food"), MapMarker("Palace of Fine Arts", 37.8029, -122.4484, "Landmarks"), MapMarker("Golden Gate Bridge", 37.8077, -122.4752, "Views"), MapMarker("Golden Gate Park", 37.7694, -122.4862, "Parks"), MapMarker("Alamo Square", 37.7764, -122.4346, "Views")], true, $stop, 340)
itinerary = Col([Pressable([Row([Box([SearchImage("Ferry Building San Francisco", 1, "md")], null, null, null, null, "md", null, 64, 64), Col([Row([Text("9:00 AM", "sm", "info", "semibold", false, false, true), Caption("45 min")], 2), Text("Ferry Building", "sm", null, "semibold"), Caption("Coffee and pastries in the 1898 market hall on the bay.")], 0)], 3)], null, true, 2), Pressable([Row([Box([SearchImage("Coit Tower San Francisco", 1, "md")], null, null, null, null, "md", null, 64, 64), Col([Row([Text("10:05 AM", "sm", "info", "semibold", false, false, true), Caption("45 min")], 2), Text("Coit Tower", "sm", null, "semibold"), Caption("Climb Telegraph Hill for Depression-era murals and a 360° view.")], 0)], 3)], null, false, 2), Pressable([Row([Box([SearchImage("Lombard Street San Francisco", 1, "md")], null, null, null, null, "md", null, 64, 64), Col([Row([Text("11:10 AM", "sm", "info", "semibold", false, false, true), Caption("30 min")], 2), Text("Lombard Street", "sm", null, "semibold"), Caption("Walk down the crooked block of brick switchbacks and hydrangeas.")], 0)], 3)], null, false, 2), Pressable([Row([Box([SearchImage("Fisherman's Wharf San Francisco", 1, "md")], null, null, null, null, "md", null, 64, 64), Col([Row([Text("12:00 PM", "sm", "info", "semibold", false, false, true), Caption("60 min")], 2), Text("Fisherman's Wharf", "sm", null, "semibold"), Caption("Sea lions at Pier 39 and clam chowder in a sourdough bowl.")], 0)], 3)], null, false, 2), Pressable([Row([Box([SearchImage("Palace of Fine Arts San Francisco", 1, "md")], null, null, null, null, "md", null, 64, 64), Col([Row([Text("1:20 PM", "sm", "info", "semibold", false, false, true), Caption("40 min")], 2), Text("Palace of Fine Arts", "sm", null, "semibold"), Caption("A Roman-style rotunda reflected in a quiet lagoon.")], 0)], 3)], null, false, 2), Pressable([Row([Box([SearchImage("Golden Gate Bridge San Francisco", 1, "md")], null, null, null, null, "md", null, 64, 64), Col([Row([Text("2:20 PM", "sm", "info", "semibold", false, false, true), Caption("75 min")], 2), Text("Golden Gate Bridge", "sm", null, "semibold"), Caption("Walk out to the first tower for the classic view back at the city.")], 0)], 3)], null, false, 2), Pressable([Row([Box([SearchImage("Golden Gate Park San Francisco", 1, "md")], null, null, null, null, "md", null, 64, 64), Col([Row([Text("3:55 PM", "sm", "info", "semibold", false, false, true), Caption("60 min")], 2), Text("Golden Gate Park", "sm", null, "semibold"), Caption("The Japanese Tea Garden and the Conservatory of Flowers.")], 0)], 3)], null, false, 2), Pressable([Row([Box([SearchImage("Alamo Square San Francisco", 1, "md")], null, null, null, null, "md", null, 64, 64), Col([Row([Text("5:15 PM", "sm", "info", "semibold", false, false, true), Caption("30 min")], 2), Text("Alamo Square", "sm", null, "semibold"), Caption("End with the Painted Ladies and the skyline at sunset.")], 0)], 3)], null, false, 2)], 1)
closing = Col([Text("Times are estimates and include about 20 minutes to get to each next stop. Cable cars run every 10 minutes or so; a Muni day pass covers them and the buses.", "xs", "muted"), Row([Button("Plan a second day", null, "outline", null, "sm", "calendar-plus")])], 2)
$pace = "Balanced"
$stop = "Ferry Building"
