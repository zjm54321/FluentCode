root = Col([head, kpis, Grid([weekly, teams], 2, 300, 4), Grid([spread, csat], 2, 300, 4), queue], 4)
head = Row([Col([Title("Support desk", "lg"), Caption("Tickets opened in the selected period")], 1), Spacer(), Box([Select($team, [{value: "All", label: "All teams"}, "Billing", "Technical", "Accounts", "Shipping"])], null, null, null, null, null, null, 150), SegmentedControl($days, [{value: "30", label: "30d"}, {value: "60", label: "60d"}, {value: "180", label: "6m"}])], 3, null, null, true)
k1 = Card([Caption("Opened"), Title("650", "xl")], null, 3, 1)
k2 = Card([Caption("Waiting"), Title("13", "xl"), Caption("1 urgent")], null, 3, 1)
k3 = Card([Caption("Median time to solve"), Title("13.9 h", "xl"), Caption("Slowest 69 h")], null, 3, 1)
k4 = Card([Caption("Satisfaction"), Title("3.3 / 5", "xl")], null, 3, 1)
kpis = Grid([k1, k2, k3, k4], 4, 150, 3)
weekly = Card([Title("Opened and solved by week", "sm"), Chart("bar", [{week: "Sep 7", Opened: 41, Solved: 41}, {week: "Sep 14", Opened: 79, Solved: 79}, {week: "Sep 21", Opened: 68, Solved: 68}, {week: "Sep 28", Opened: 98, Solved: 98}, {week: "Oct 5", Opened: 59, Solved: 59}, {week: "Oct 12", Opened: 70, Solved: 70}, {week: "Oct 19", Opened: 90, Solved: 90}, {week: "Oct 26", Opened: 76, Solved: 76}, {week: "Nov 2", Opened: 69, Solved: 56}], "week", ["Opened", "Solved"])], null, 4, 2)
