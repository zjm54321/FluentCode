root = Col([head, kpis, Grid([trend, mix], 2, 300, 4), Grid([regions, top], 2, 300, 4)], 4)
head = Row([Col([Title("Store performance", "lg"), Caption("Demo data, refreshed every 5 minutes")], 1), Spacer(), Box([Select($channel, [{value: "All", label: "All channels"}, "Web", "Mobile", "Retail"])], null, null, null, null, null, null, 150), SegmentedControl($days, [{value: "30", label: "30d"}, {value: "90", label: "90d"}, {value: "365", label: "1y"}])], 3, null, null, true)
k1 = Card([Caption("Revenue"), Title("$629.2K", "xl")], null, 3, 1)
k2 = Card([Caption("Orders"), Title("3,721", "xl")], null, 3, 1)
k3 = Card([Caption("Average order"), Title("$169.09", "xl")], null, 3, 1)
k4 = Card([Caption("Last 7 days"), Row([Title("$49.3K", "xl"), Badge("+3.8% vs prior 7", "success")], 2, null, null, true)], null, 3, 1)
kpis = Grid([k1, k2, k3, k4], 4, 150, 3)
trend = Card([Row([Title("Revenue", "sm"), Spacer(), SegmentedControl($view, ["Weekly", "Cumulative"])], 2), Chart("area", [{key: "2026-08-10", value: 36832.14}, {key: "2026-08-17", value: 43825.819999999985}, {key: "2026-08-24", value: 42432.31000000001}, {key: "2026-08-31", value: 47086.700000000004}, {key: "2026-09-07", value: 44661.21}, {key: "2026-09-14", value: 58100.88}, {key: "2026-09-21", value: 54562.09000000001}, {key: "2026-09-28", value: 51157.65999999999}, {key: "2026-10-05", value: 51704.25000000001}, {key: "2026-10-12", value: 54330.28000000005}, {key: "2026-10-19", value: 47717.06999999997}, {key: "2026-10-26", value: 47489.819999999956}, {key: "2026-11-02", value: 49284.37999999999}], "key", ["value"], "currency")], null, 4, 2)
mix = Card([Title("Channel mix", "sm"), Chart("donut", [{key: "Mobile", value: 238782.6300000004}, {key: "Web", value: 272955.4400000004}, {key: "Retail", value: 117446.53999999994}], "key", ["value"], "currency")], null, 4, 2)
regions = Card([Title("Revenue by region and category", "sm"), Chart("bar", [{key: "East", Apparel: 31254.849999999995, Home: 23033.459999999995, Outdoors: 60658.61000000004, Electronics: 44980.29000000001}, {key: "South", Apparel: 23519.46, Home: 16894.17, Outdoors: 38457.799999999996, Electronics: 29632.72}, {key: "West", Apparel: 39307.04000000001, Home: 29398.539999999986, Outdoors: 86089.56999999993, Electronics: 57061.399999999994}, {key: "North", Apparel: 30958.31999999999, Home: 20145.44, Outdoors: 55998.66000000002, Electronics: 41794.27999999998}], "key", null, "currency", null, true)], null, 4, 2)
top = Card([Title("Top products", "sm"), Table(["Product", "Units", "Revenue"], [["Trail runner", 972, "$117,853"], ["Wireless earbuds", 633, "$90,310"], ["Rain shell", 534, "$82,690"], ["Wool sweater", 574, "$52,186"], ["Portable speaker", 447, "$50,979"]])], null, 4, 2)
$channel = "All"
$days = "90"
$view = "Weekly"
