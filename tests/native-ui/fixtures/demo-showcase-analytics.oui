$period = "本周"
data = [{day:"周一",direct:42,search:30,social:18,email:15,partner:12,other:8},{day:"周二",direct:58,search:36,social:24,email:18,partner:16,other:9},{day:"周三",direct:51,search:44,social:27,email:21,partner:14,other:11},{day:"周四",direct:72,search:48,social:31,email:25,partner:20,other:13},{day:"周五",direct:84,search:62,social:38,email:29,partner:24,other:16}]
metrics = [{icon:"dollar-sign",label:"总收入",value:"¥128,430",delta:"+18.6%",tone:"success"},{icon:"users",label:"活跃客户",value:"2,846",delta:"+12.4%",tone:"info"},{icon:"shopping-cart",label:"订单数",value:"1,204",delta:"+8.2%",tone:"purple"},{icon:"check-circle",label:"转化率",value:"4.82%",delta:"+0.6pp",tone:"pink"}]
