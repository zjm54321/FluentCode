root = Col([Card([Row([Col([Title("经营概览","lg"),Caption("Northstar 工作室 · 多渠道收入与客户增长")],1),Badge("实时快照","success","check-circle")],3,"center","between"),SegmentedControl($period,["本周","本月","本季度"],true),stats,Row([Title($period + " · 渠道贡献","md"),Popover([Icon("info")],[Text("每个系列使用统一的六色原生图表调色板；数据为离线演示。")])],2,"center","between"),Chart("bar",data,"day",["direct","search","social","email","partner","other"],"currency","CNY",true,220),Divider(),Title("重点客户","md"),Table(["客户 / 套餐","状态","本月收入","负责人"],[[Text("Atlas · 企业版","sm",null,"semibold"),Badge("续费中","success","check"),42800,"林青"],[Text("Orbit · 团队版","sm",null,"semibold"),Badge("增长","purple","arrow-up-right"),28600,"陈溪"],[Text("Lumen · 专业版","sm",null,"semibold"),Badge("待跟进","warning","clock"),18400,"Maya"]]),Row([Caption("更新于 09:41 · 3 个重点客户 · 金额为人民币"),Button("生成经营简报",@ToAssistant("请根据这份经营概览整理本周的增长机会。",{period:$period}),"outline",null,"sm","sparkles")],3,"center","between")],"outline",4,3)])
