$count = 0
root = Col([Card([Row([Title("按键尺寸", "md"), Badge("AI 可选 · 原生自适应", "info", "grid")], 2, "center", "between"), Caption("size 明确指定时优先；不指定时，短标签按键跟随列宽。"), Label("Button · sm 32 / md 40 / lg 48"), Row([Button("小号", @Set($count, $count + 1), "soft", null, "sm"), Button("中号", @Set($count, $count + 1), "soft", null, "md"), Button("大号", @Set($count, $count + 1), "soft", null, "lg")]), Label("IconButton · sm 32 / md 40 / lg 48"), Row([IconButton("minus", @Set($count, $count - 1), "小号减一", "outline", "sm"), IconButton("plus", @Set($count, $count + 1), "中号加一", "outline", "md"), IconButton("check", @Reset($count), "大号重置", "solid", "lg")]), Divider(), Label("自适应键盘 · 高度 = 列宽 × 0.8，限制在 40–56 px"), Grid([Button("7", @Set($count, 7), "outline"), Button("8", @Set($count, 8), "outline"), Button("9", @Set($count, 9), "outline"), Button("+", @Set($count, $count + 1), "soft"), Button("4", @Set($count, 4), "outline"), Button("5", @Set($count, 5), "outline"), Button("6", @Set($count, 6), "outline"), Button("=", @Set($count, $count * 2), "solid")], 4, 120, 2), Card([Caption("当前结果"), Title("" + $count, "xl"), Caption("浅色与深色均保留对比；soft 比深色卡片略亮。")], "soft", 3, 1)], "outline", 4, 3)])
