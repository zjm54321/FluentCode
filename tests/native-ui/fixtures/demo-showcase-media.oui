$saved = false
root = Col([Card([Row([Col([Title("灵感资料库","lg"),Caption("图片、搜索和视频的原生预览，保留标题、描述与安全的外部入口")],1),IconButton("heart",@Set($saved,!$saved),"收藏资料","outline","lg")],3,"center","between"),Grid([Card([Image("https://images.unsplash.com/photo-1499750310107-5fef28a66643","明亮工作台与笔记本",1.5,"md","cover"),Title("专注的工作空间","md"),Badge("摄影参考","purple","camera"),Text("留白、自然光和可触及的工具，让想法更容易落地。","sm","muted"),Caption("图片不会自动加载；点击加载后才请求 HTTPS 资源。")],"outline",3,3),Card([SearchImage("Japanese minimalist workspace",1.5,"md","cover"),Title("寻找更多视觉线索","md"),Badge("图片搜索","info","search"),Text("把查询词保留在卡片中，确认链接后在浏览器继续探索。","sm","muted"),Caption("没有后台搜索、跟踪或自动资源请求。")],"outline",3,3),Card([YouTube("jNQXAC9IVRw","Me at the zoo · YouTube 首个视频"),Title("视频参考","md"),Badge("外部媒体","pink","play"),Text("已知视频链接的原生预览；播放器在确认后由浏览器打开。","sm","muted"),Caption("不嵌入网页播放器，不自动下载封面。")],"outline",3,3)],3,220,3),Quote("收集不是目的，能帮助下一次创作的线索才值得留下。","工作室资料笔记"),Row([Badge($saved ? "已收藏到当前卡片" : "尚未收藏",$saved ? "success" : "neutral","heart"),Spacer(),Button("整理创作方向",@ToAssistant("请根据这组工作空间、图片搜索和视频参考整理三个创作方向。"),"solid",null,"md","sparkles")],3,"center","between"),Caption("媒体服务的原生安全替代会明确显示；不会把离线占位图伪装成已加载媒体。")],"outline",4,3)])
