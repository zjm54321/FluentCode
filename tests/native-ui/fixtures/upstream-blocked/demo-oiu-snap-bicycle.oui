root = Col([head, photos, Title("The main parts", "md"), parts, Title("How power reaches the wheel", "md"), flow, explorer, Title("Freewheel or cassette?", "md"), hubs, closing])
head = Col([Title("Inside a 7-speed bike", "xl"), Text("One chainring at the front, seven sprockets at the back and a derailleur that moves the chain between them. Small sprockets make each pedal stroke go further; big ones make hills easier.", "md", "muted")], 2)
photos = Grid([SearchImage("City bicycle", 1.3, "lg"), SearchImage("Derailleur", 1.3, "lg"), SearchImage("Bicycle shifter", 1.3, "lg")], 3, 150, 2)
parts = Table(["Part", "What it does"], [["Frame and fork", "Hold everything together, steer and set the riding position"], ["Crankset and pedals", "Turn leg power into rotation"], ["Chainring", "The single front gear, here 40 teeth"], ["Chain", "Carries the power to the rear wheel"], ["7 rear sprockets", "Seven sizes, so seven gear ratios"], ["Rear derailleur", "Moves the chain from sprocket to sprocket"], ["Shifter and cable", "Pull or release the cable to pick a gear"], ["Brakes, wheels and tires", "Stop, roll and grip the road"]])
flow = Card([Row([Row([Box([Text("Pedals", "sm", null, "medium")], null, null, 2, "surface", "md"), Icon("arrow-right", "sm", "faint")], 1), Row([Box([Text("Chainring", "sm", null, "medium")], null, null, 2, "surface", "md"), Icon("arrow-right", "sm", "faint")], 1), Row([Box([Text("Chain", "sm", null, "medium")], null, null, 2, "surface", "md"), Icon("arrow-right", "sm", "faint")], 1), Row([Box([Text("Rear sprocket", "sm", null, "medium")], null, null, 2, "surface", "md"), Icon("arrow-right", "sm", "faint")], 1), Row([Box([Text("Rear wheel", "sm", null, "medium")], null, null, 2, "surface", "md"), null], 1)], 1, "center", "center", true), Caption("The shifter pulls a cable; the derailleur guides the chain onto the sprocket you choose.")], "soft", 3, 2)
exHead = Row([Col([Label("Explore the seven gears"), Title("Gear 3 of 7", "xl")], 1), Spacer(), Badge("Moderate, for cruising", "info")], 3, null, null, true)
cogs = Svg([G([Circle(26, 52, 21.400000000000002, "surface", "faint", 2, 1), Circle(26, 52, 4, "muted"), SvgText("28T", 26, 104, 11, "muted", "middle", "normal")]), G([Circle(71, 52, 19.200000000000003, "surface", "faint", 2, 1), Circle(71, 52, 4, "muted"), SvgText("24T", 71, 104, 11, "muted", "middle", "normal")]), G([Circle(116, 52, 17.55, "info", "info", 2, 0.85), Circle(116, 52, 4, "muted"), SvgText("21T", 116, 104, 11, "info", "middle", "semibold")]), G([Circle(161, 52, 15.9, "surface", "faint", 2, 1), Circle(161, 52, 4, "muted"), SvgText("18T", 161, 104, 11, "muted", "middle", "normal")]), G([Circle(206, 52, 14.8, "surface", "faint", 2, 1), Circle(206, 52, 4, "muted"), SvgText("16T", 206, 104, 11, "muted", "middle", "normal")]), G([Circle(251, 52, 13.700000000000001, "surface", "faint", 2, 1), Circle(251, 52, 4, "muted"), SvgText("14T", 251, 104, 11, "muted", "middle", "normal")]), G([Circle(296, 52, 12.600000000000001, "surface", "faint", 2, 1), Circle(296, 52, 4, "muted"), SvgText("12T", 296, 104, 11, "muted", "middle", "normal")])], "0 0 320 112")
s1 = Card([Caption("Rear sprocket"), Title("21 teeth", "lg")], "soft", 3, 1)
s2 = Card([Caption("Gear ratio"), Title("1.9 : 1", "lg")], "soft", 3, 1)
s3 = Card([Caption("Speed at 80 rpm"), Title("19.2 km/h", "lg")], "soft", 3, 1)
stats = Grid([s1, s2, s3], 3, 90, 2)
explorer = Card([exHead, cogs, Slider($gear, 1, 7, 1, "Gear", null, [{value: 1, label: "1 · Easy"}, {value: 4, label: "4"}, {value: 7, label: "7 · Fast"}]), stats, Slider($rpm, 50, 110, 5, "Pedaling cadence", " rpm"), Text("Each turn of the pedals turns the rear wheel 1.9 times. Balanced effort for flat roads and everyday riding.", "sm"), Caption("Assumes a 40-tooth chainring, a 12-28 freewheel and a 700c wheel (2.1 m around). Real bikes vary.")], null, 4, 3)
h1 = Card([Text("Freewheel", "sm", null, "semibold"), Caption("The ratchet sits inside the sprocket cluster, which screws onto the hub. Common on budget and youth bikes.")], "soft", 3, 1)
h2 = Card([Text("Cassette", "sm", null, "semibold"), Caption("The sprockets slide onto a freehub that holds the ratchet. Better axle support and easy gear swaps.")], "soft", 3, 1)
hubs = Col([SearchImage("Cassette (bicycle)", 2.4, "lg"), Grid([h1, h2], 2, 220, 3)], 3)
closing = Text("Seven speeds keep the drivetrain simple, light and cheap to maintain: one shifter, one derailleur and no front gear changes to think about.", "sm", "muted")
$gear = 3
$rpm = 80
