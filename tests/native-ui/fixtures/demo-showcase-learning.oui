$answer = false
$seconds = 300
cards = Carousel([Flashcard([Icon("code","xl","info"),Title("响应式状态","md"),Text("输入改变后，相关内容会怎样更新？","sm","muted")],[Title("只更新依赖它的内容","md"),Text("$state 保存值；组件表达式在变化后重新计算。")],"点击查看解释"),Flashcard([Icon("lock","xl","purple"),Title("显式的外部动作","md"),Text("卡片能否在后台打开网页？","sm","muted")],[Title("需要确认完整 URL","md"),Text("Link / @OpenUrl 先展示目的地址，再交给系统浏览器。")],"点击翻面"),Flashcard([Icon("bar-chart","xl","pink"),Title("统一的数据语言","md"),Text("六色图表调色板有什么作用？","sm","muted")],[Title("跨卡片保持辨识度","md"),Text("系列颜色随深浅主题调整，数值与对比仍然清晰。")],"点击翻面"),Flashcard("原生键盘导航","使用 Tab、方向键和 Enter 操作真正的 WinUI 控件。","再来一张")],240,3)
diagram = Svg([Rect(0,0,360,120,"surface","faint",1,1,8),G([Circle(55,58,24,"none","info",2),SvgText("输入",55,63,14,"text","middle","semibold"),Line(86,58,145,58,"chart2",3),Polygon("142,52 154,58 142,64","chart2"),Rect(158,34,76,48,"purple","purple",1,0.25,6),SvgText("状态",196,63,14,"text","middle","semibold"),Path("M 238 58 C 258 58 264 58 278 58","none","chart3",3),Ellipse(311,58,28,24,"pink",null,null,0.25),SvgText("界面",311,63,14,"text","middle","semibold"),Polyline("22,100 90,90 150,96 224,86 337,92","chart2",2,"none",0.6)],null,1)],"0 0 360 120","100%",120)
root = Col([Card([Row([Col([Title("原生 UI 学习卡","lg"),Caption("可翻转闪卡、计时器、矢量说明和可复制代码")],1),Badge("交互式复习","purple","sparkles")],3,"center","between"),cards,Grid([Card([Title("一次状态变化的旅程","md"),diagram,Markdown("**原生 XAML 绘图**：没有 SVG 文档、脚本或外部资源。"),Math("UI = f(state)")],"soft",3,3),Card([Label("专注练习"),Timer($seconds,"专注复习"),Code("$count = 0\nroot = Button(\"Add\", @Set($count, $count + 1))","openui"),Caption("代码块只展示与复制，不会执行。")],"outline",3,3)],2,280,3),Checkbox($answer,"我能解释输入、状态和界面之间的关系"),Celebration($answer),Row([Badge($answer ? "复习完成" : "继续探索",$answer ? "success" : "neutral","check-circle"),Spacer(),Button("给我一道练习题",@ToAssistant("请给我一道关于 OpenUI 状态和原生交互的练习题。",{reviewed:$answer}),"solid",null,"md","send")],3),Caption("公式保留源文本；闪卡翻面状态与计时状态跟随卡片，不依赖网页运行时。")],"outline",4,3)])
