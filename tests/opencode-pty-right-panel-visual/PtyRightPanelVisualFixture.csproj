<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion><RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget><UseWinUI>true</UseWinUI><WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained><SelfContained>false</SelfContained>
    <WindowsSdkPackageVersion>10.0.26100.57</WindowsSdkPackageVersion>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition><EnableDefaultPageItems>false</EnableDefaultPageItems>
    <Nullable>enable</Nullable><DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants><ApplicationManifest>../opencode-browser-foundation/native/app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ApplicationDefinition Include="App.xaml" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="[1.8.260921001]" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="[10.0.26100.9169]" />
    <Compile Include="../../src/AIFrontend/Pages/OpenCode/OpenCodeInteractionUi.cs" Link="Production/InteractionUi.cs" />
    <Compile Include="../../src/AIFrontend/Pages/OpenCode/OpenCodeBrowserOverlayLayout.cs" Link="Production/BrowserOverlayLayout.cs" />
    <Compile Include="../../src/AIFrontend/Pages/OpenCode/OpenCodePersistentPtyPresentation.cs" Link="Production/PtyPresentation.cs" />
    <Compile Include="../../src/AIFrontend/Pages/OpenCode/OpenCodePersistentPtySurface.cs" Link="Production/PtySurface.cs" />
    <Compile Include="../../src/AIFrontend/Pages/OpenCode/OpenCodePersistentPtyRenderer.cs" Link="Production/PtyRenderer.cs" />
    <Compile Include="../../src/AIFrontend/Pages/OpenCode/OpenCodePersistentPtyView.cs" Link="Production/PtyView.cs" />
    <Compile Include="../../src/AIFrontend/Pages/OpenCode/OpenCodePersistentPtyInventoryPresentation.cs" Link="Production/PtyInventoryPresentation.cs" />
    <Compile Include="../../src/AIFrontend/Pages/OpenCode/OpenCodePersistentPtyInventoryView.cs" Link="Production/PtyInventoryView.cs" />
    <Compile Include="../../src/AIFrontend/Pages/OpenCode/OpenCodePersistentPtyOverlay.cs" Link="Production/PtyOverlay.cs" />
    <Compile Include="../../src/AIFrontend/Services/OpenCode/PersistentPtyModels.cs" Link="Production/PersistentPtyModels.cs" />
    <Content Include="../../src/AIFrontend/Assets/OpenCode/PersistentPty/**/*" Link="Assets/OpenCode/PersistentPty/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
