<Application x:Class="PtyRightPanelVisual.Fixture" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" /></ResourceDictionary.MergedDictionaries>
      <!-- Copies of the production App.xaml keys the PTY views resolve through OpenCodeInteractionUi.TryStyle. -->
      <FontFamily x:Key="AppMonospaceFontFamily">Cascadia Mono, Consolas</FontFamily>
      <Style x:Key="CaptionSubtleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
      </Style>
      <Style x:Key="OpenCodeCodeTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="FontFamily" Value="{StaticResource AppMonospaceFontFamily}" />
      </Style>
      <Style x:Key="OpenCodeTransparentToolButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
